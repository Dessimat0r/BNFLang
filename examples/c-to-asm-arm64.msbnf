// C-like → ARM64 assembly (Apple Silicon, macOS) (Meta-SBNF)
// Engine: PEG + LET RULE REPLACE.
// Operators: + - * / < <=

$IDENT = /[a-zA-Z_]\w*/
$DECL_HDR = $NUM:n "\x00" /[^\x00]*/:i "\x00" /(?:long\s+long|char|short|int|long|void)\s*/

Program ::= /[\s\S]*/:src => RULE("Decls", "4\x00\x00" + src)

// ── Declaration phase ─────────────────────────────────────────────────────

Decls ::= $NUM:n "\x00" /[^\x00]*/:i "\x00" /[\s\S]*/:c => RULE("TryDecl", n + "\x00" + i + "\x00" + c)

TryDecl ::= $DECL_HDR /\*+/ $IDENT:v "=" "&" $VAR:ref ";" "\n" /[\s\S]*/:c
    => DECL(v, n, i, c, "sub x16, x29, #" + RULE("OffOf", ref) \+ "str x16, [x29, #-" + n + "]" \+ "")
  | $DECL_HDR /\*+/ $IDENT:v ";" "\n" /[\s\S]*/:c => DECL(v, n, i, c, "")
  | $DECL_HDR $IDENT:v "=" "0" ";" "\n" /[\s\S]*/:c => DECL(v, n, i, c, "str wzr, [x29, #-" + n + "]" \+ "")
  | $DECL_HDR $IDENT:v "=" /[^;\x00]+/:val ";" "\n" /[\s\S]*/:c
    => let val_asm = RULE("Expr", val); DECL(v, n, i, c, val_asm \+ "str w0, [x29, #-" + n + "]" \+ "")
  | $NUM:n "\x00" /[^\x00]*/:i "\x00" /[\s\S]*/:c
    => ".data\nfmt: .asciz \"%d\\n\"\nfmtn: .asciz \"%d \"\nfmt_nl: .asciz \"\\n\"\nfmt_sp: .asciz \" \"\nfmt_2d: .asciz \"%d %d\\n\"\nfmt_3d: .asciz \"%d %d %d\\n\"\n"
     + ".text\n.globl _main\n"
     + "_main:\nstp x29, x30, [sp, #-16]!\nmov x29, sp\nsub sp, sp, #" + RULE("Ceil16", n + "32") + "\n"
     + i
     + RULE("Stmts", "0\x00" + c)
     + "mov sp, x29\nldp x29, x30, [sp], #16\nret\n"

// ── Statement phase ──────────────────────────────────────────────────────

Stmts ::= $NUM:lc "\x00" /[\s\S]*/:code => RULE("S", lc + "\x00" + code)

S ::= $NUM:lc "\x00" "while" "(" $PAREN:cond ")" "{" WhileBody:body "}" /[\s\S]*/:rest
    => RULE("GenWhile", lc + "\x00" + cond + "\x00" + body) + "\n" + RULE("S", (lc + "2") + "\x00" + rest)
  | $NUM:lc "\x00" "while" "(" $PAREN:cond ")" "{" WhileBody:body "}" => RULE("GenWhile", lc + "\x00" + cond + "\x00" + body)
  | $NUM:lc "\x00" Stmt:first "\n" /[\s\S]*/:rest => first + "\n" + RULE("S", lc + "\x00" + rest)
  | $NUM:lc "\x00" Stmt:last => last + "\n"
  | => ""

Stmt ::=
    "print3" $VAR:v1 $VAR:v2 $VAR:v3 ";"
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); let a3 = RULE("Expr", v3); a1 \+ "str x0, [sp]" \+ a2 \+ "str x0, [sp, #8]" \+ a3 \+ "str x0, [sp, #16]" \+ "adrp x0, fmt_3d@PAGE" \+ "add x0, x0, fmt_3d@PAGEOFF" \+ "bl _printf"
  | "print2" $VAR:v1 $VAR:v2 ";"
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); a1 \+ "str x0, [sp]" \+ a2 \+ "str x0, [sp, #8]" \+ "adrp x0, fmt_2d@PAGE" \+ "add x0, x0, fmt_2d@PAGEOFF" \+ "bl _printf"
  | "sprintf3" $VAR:buf $VAR:v1 $VAR:v2 $VAR:v3 ";"
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); let a3 = RULE("Expr", v3); let buf_off = RULE("OffOf", buf + "\x00" + v1); a1 \+ "str x0, [sp]" \+ a2 \+ "str x0, [sp, #8]" \+ a3 \+ "str x0, [sp, #16]" \+ "sub x0, x29, #" + buf_off \+ "adrp x1, fmt_3d@PAGE" \+ "add x1, x1, fmt_3d@PAGEOFF" \+ "bl _sprintf"
  | "sprintf2" $VAR:buf $VAR:v1 $VAR:v2 ";"
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); let buf_off = RULE("OffOf", buf + "\x00" + v1); a1 \+ "str x0, [sp]" \+ a2 \+ "str x0, [sp, #8]" \+ "sub x0, x29, #" + buf_off \+ "adrp x1, fmt_2d@PAGE" \+ "add x1, x1, fmt_2d@PAGEOFF" \+ "bl _sprintf"
  | "sprintf" $VAR:buf $VAR:val ";"
    => let val_asm = RULE("Expr", val); let buf_off = RULE("OffOf", buf + "\x00" + val); val_asm \+ "str x0, [sp]" \+ "sub x0, x29, #" + buf_off \+ "adrp x1, fmt@PAGE" \+ "add x1, x1, fmt@PAGEOFF" \+ "bl _sprintf"
%for kw, fmt in [("println", "fmt_nl"), ("printsp", "fmt_sp")] {
  | "{kw}" ";" => "adrp x0, {fmt}@PAGE" \+ "add x0, x0, {fmt}@PAGEOFF" \+ "bl _printf"
}
%for kw, fmt in [("printn", "fmtn"), ("print", "fmt")] {
  | "{kw}" /[^;]+/:val ";" => RULE("Expr", val) \+ "str x0, [sp]" \+ "adrp x0, {fmt}@PAGE" \+ "add x0, x0, {fmt}@PAGEOFF" \+ "bl _printf"
}
  | "*" PtrChain:ptr "=" /[^;]+/:val ";"
    => let val_asm = RULE("Expr", val); ptr \+ "str x0, [sp, #-16]!" \+ val_asm \+ "ldr x1, [sp], #16" \+ "str w0, [x1]"
  | $VAR:name "=" /[^;]+/:val ";" => let off = RULE("OffOf", name + "\x00" + val); RULE("Expr", val) \+ "str w0, [x29, #-" + off + "]"
  | "{" => "" | "}" => "" | /[\s]+/:ws => "" | /./:c => c

OffOf ::= $VAR_OFF => off | $IDENT:name => name

// ── While loop ───────────────────────────────────────────────────────────

WhileBody ::= /[^{}]+/:text WhileBody:rest => text + rest | "{" WhileBody:inner "}" WhileBody:rest => "{" + inner + "}" + rest | => ""

GenWhile ::= $NUM:lc "\x00" /[^\x00]+/:cond "\x00" /[\s\S]*/:body
    => ".L" + lc + ":\n" + RULE("Expr", cond) \+ "cbz w0, .L" + (lc + "1") \+ RULE("Stmts", (lc + "2") + "\x00" + body) \+ "b .L" + lc \+ ".L" + (lc + "1") + ":\n"

// ── Expression rules ─────────────────────────────────────────────────────

Expr ::= /[\s\S]+/:s => RULE("Compare", s)

%for op, cond in [("<=", "le"), ("<", "lt")] {
Compare ::= $NO_COMP:l "{op}" /[\s\S]+/:r
    => RULE("Expr", l) \+ "str w0, [sp, #-16]!" \+ RULE("Expr", r) \+ "ldr w1, [sp], #16" \+ "cmp w1, w0" \+ "cset w0, {cond}"
}
  | /[\s\S]+/:s => RULE("AddExpr", s)

AddExpr ::= $NO_ADD:l /[+-]/ "0" => RULE("Expr", l)
          | "0" "+" $NO_ADD:r => RULE("Expr", r)
%for op, inst in [("+", "add"), ("-", "sub")] {
          | $NO_ADD:l "{op}" $NUM:r => RULE("Expr", l) \+ "{inst} w0, w0, #" + r
          | $NO_ADD:l "{op}" $VAR:r => RULE("Expr", r) \+ "mov w8, w0" \+ RULE("Expr", l) \+ "{inst} w0, w0, w8"
          | $NO_ADD:l "{op}" /[\s\S]+/:r => RULE("Expr", l) \+ "str w0, [sp, #-16]!" \+ RULE("Expr", r) \+ "ldr w1, [sp], #16" \+ "{inst} w0, w1, w0"
}
  | /[\s\S]+/:s => RULE("MulExpr", s)

MulExpr ::= $NO_MUL:l "*" "0" => "mov w0, 0"
          | "0" /[*/]/ $NO_MUL:r => "mov w0, 0"
          | $NO_MUL:l /[*/]/ "1" => RULE("Expr", l)
          | "1" "*" $NO_MUL:r => RULE("Expr", r)
          | $NO_MUL:l "*" "2" => RULE("Expr", l) \+ "add w0, w0, w0"
%for val, shift in [("4","2"), ("8","3")] {
          | $NO_MUL:l "*" "{val}" => RULE("Expr", l) \+ "lsl w0, w0, {shift}"
}
%for op, inst in [("*", "mul"), ("/", "sdiv")] {
          | $NO_MUL:l "{op}" $NUM:r => RULE("Expr", r) \+ "mov w8, w0" \+ RULE("Expr", l) \+ "{inst} w0, w0, w8"
          | $NO_MUL:l "{op}" $VAR:r => RULE("Expr", r) \+ "mov w8, w0" \+ RULE("Expr", l) \+ "{inst} w0, w0, w8"
          | $NO_MUL:l "{op}" /[\s\S]+/:r => RULE("Expr", l) \+ "str w0, [sp, #-16]!" \+ RULE("Expr", r) \+ "ldr w1, [sp], #16" \+ "{inst} w0, w1, w0"
}
  | /[\s\S]+/:s => RULE("Primary", s)

Primary ::= "(" $PAREN:e ")" => RULE("Expr", e)
          | "&" $VAR:name => RULE("AddrOf", name)
          | "*" PtrChain:inner => inner \+ "ldr w0, [x0]"
          | "0" => "mov w0, 0"
          | $NUM:n => "mov w0, " + n
          | $VAR:name => RULE("AnnotatedVar", name)

PtrChain ::= $VAR:name => RULE("LoadQWord", name) | "*" PtrChain:inner => inner \+ "ldr x0, [x0]"

AnnotatedVar ::= $VAR_OFF => "ldr w0, [x29, #-" + off + "]" | $IDENT:name => "ldr w0, [x29, #-" + name + "]"
LoadQWord    ::= $VAR_OFF => "ldr x0, [x29, #-" + off + "]" | $IDENT:name => "ldr x0, [x29, #-" + name + "]"
AddrOf       ::= $VAR_OFF => "sub x0, x29, #" + off

Ceil16 ::=
%for k in range(4, 289, 4) {
    "{k}" => "{((k + 15) // 16) * 16}" |
}
    "0" => "0" | $NUM:n => n
