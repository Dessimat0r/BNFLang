// C-like → ARM64 assembly (Apple Silicon, macOS) (Meta-SBNF)
// Engine: PEG + LET RULE REPLACE.
// Operators: + - * / < <=

$IDENT = /[a-zA-Z_]\w*/

Program ::= /[\s\S]*/:src
    => RULE("Decls", "4\x00\x00" + src)

// ── Declaration phase ─────────────────────────────────────────────────────

Decls ::= $NUM:n "\x00" /[^\x00]*/:i "\x00" /[\s\S]*/:c
    => RULE("TryDecl", n + "\x00" + i + "\x00" + c)

TryDecl ::= $NUM:n "\x00" /[^\x00]*/:i "\x00int " "*" $IDENT:v "=" "&" $VAR:ref ";" "\n" /[\s\S]*/:c
    => let new_n = n + "8";
       let ref_off = RULE("OffOfPtr", ref);
       let anno = v + "@" + n;
       let new_i = i + "sub x16, x29, #" + ref_off \+ "str x16, [x29, #-" + n + "]" \+ "";
       RULE("Decls", new_n + "\x00" + new_i + "\x00" + REPLACE(v, anno, c))
  | $NUM:n "\x00" /[^\x00]*/:i "\x00int " "*" "*" $IDENT:v "=" "&" $VAR:ref ";" "\n" /[\s\S]*/:c
    => let new_n = n + "8";
       let ref_off = RULE("OffOfPtr", ref);
       let anno = v + "@" + n;
       let new_i = i + "sub x16, x29, #" + ref_off \+ "str x16, [x29, #-" + n + "]" \+ "";
       RULE("Decls", new_n + "\x00" + new_i + "\x00" + REPLACE(v, anno, c))
  | $NUM:n "\x00" /[^\x00]*/:i "\x00int " "*" $IDENT:v ";" "\n" /[\s\S]*/:c
    => let new_n = n + "8";
       let anno = v + "@" + n;
       RULE("Decls", new_n + "\x00" + i + "\x00" + REPLACE(v, anno, c))
  | $NUM:n "\x00" /[^\x00]*/:i "\x00int " $IDENT:v "=" "0" ";" "\n" /[\s\S]*/:c
    => let new_n = n + "8";
       let anno = v + "@" + n;
       let new_i = i + "str wzr, [x29, #-" + n + "]" \+ "";
       RULE("Decls", new_n + "\x00" + new_i + "\x00" + REPLACE(v, anno, c))
  | $NUM:n "\x00" /[^\x00]*/:i "\x00int " $IDENT:v "=" /[^;\x00]+/:val ";" "\n" /[\s\S]*/:c
    => let new_n = n + "8";
       let anno = v + "@" + n;
       let new_i = i + "mov w0, " + val \+ "str w0, [x29, #-" + n + "]" \+ "";
       RULE("Decls", new_n + "\x00" + new_i + "\x00" + REPLACE(v, anno, c))
  | $NUM:n "\x00" /[^\x00]*/:i "\x00" /[\s\S]*/:c
    => ".data\nfmt: .asciz \"%d\\n\"\nfmtn: .asciz \"%d \"\nfmt_nl: .asciz \"\\n\"\nfmt_sp: .asciz \" \"\n"
     + ".text\n.globl _main\n"
     + "_main:\nstp x29, x30, [sp, #-16]!\nmov x29, sp\nsub sp, sp, #" + RULE("Ceil16", n) + "\n"
     + i
     + RULE("Stmts", "0\x00" + c)
     + "mov sp, x29\nldp x29, x30, [sp], #16\nret\n"

// ── Statement phase ──────────────────────────────────────────────────────

Stmts ::= $NUM:lc "\x00" /[\s\S]*/:code
    => RULE("S", lc + "\x00" + code)

S ::= $NUM:lc "\x00" "while" "(" $PAREN:cond ")" "{" WhileBody:body "}" /[\s\S]*/:rest
    => RULE("GenWhile", lc + "\x00" + cond + "\x00" + body) + "\n" + RULE("S", (lc + "2") + "\x00" + rest)
  | $NUM:lc "\x00" "while" "(" $PAREN:cond ")" "{" WhileBody:body "}"
    => RULE("GenWhile", lc + "\x00" + cond + "\x00" + body)
  | $NUM:lc "\x00" Stmt:first "\n" /[\s\S]*/:rest
    => first + "\n" + RULE("S", lc + "\x00" + rest)
  | $NUM:lc "\x00" Stmt:last
    => last + "\n"
  | => ""

Stmt ::=
    "println" ";"
    => "adrp x0, fmt_nl@PAGE" \+ "add x0, x0, fmt_nl@PAGEOFF" \+ "bl _printf"
  | "printsp" ";"
    => "adrp x0, fmt_sp@PAGE" \+ "add x0, x0, fmt_sp@PAGEOFF" \+ "bl _printf"
  | "printn" /[^;]+/:val ";"
    => RULE("Expr", val) \+ "str x0, [sp]" \+ "adrp x0, fmtn@PAGE" \+ "add x0, x0, fmtn@PAGEOFF" \+ "bl _printf"
  | "print" /[^;]+/:val ";"
    => RULE("Expr", val) \+ "str x0, [sp]" \+ "adrp x0, fmt@PAGE" \+ "add x0, x0, fmt@PAGEOFF" \+ "bl _printf"
  | "*" PtrChain:ptr "=" /[^;]+/:val ";"
    => let val_asm = RULE("Expr", val);
       ptr \+ "str x0, [sp, #-16]!" \+ val_asm \+ "ldr x1, [sp], #16" \+ "str w0, [x1]"
  | $VAR:name "=" /[^;]+/:val ";"
    => let off = RULE("OffOf", name + "\x00" + val);
       RULE("Expr", val) \+ "str w0, [x29, #-" + off + "]"
  | "{" => ""
  | "}" => ""
  | /[\s]+/:ws => ""
  | /./:c => c

OffOf ::= /[^@]+/:name "@" $NUM:off "\x00" /[\s\S]*/:rest => off
        | $IDENT:name "\x00" /[\s\S]*/:rest => name

// ── While loop ───────────────────────────────────────────────────────────

WhileBody ::= /[^{}]+/:text WhileBody:rest => text + rest
            | "{" WhileBody:inner "}" WhileBody:rest => "{" + inner + "}" + rest
            | => ""

GenWhile ::= $NUM:lc "\x00" /[^\x00]+/:cond "\x00" /[\s\S]*/:body
    => ".L" + lc + ":\n"
     + RULE("Expr", cond) \+ "cbz w0, .L" + (lc + "1") \+ RULE("Stmts", (lc + "2") + "\x00" + body) \+ "b .L" + lc \+ ".L" + (lc + "1") + ":\n"

// ── Expression rules ─────────────────────────────────────────────────────

Expr ::= /[\s\S]+/:s => RULE("Compare", s)

Compare ::= $NO_COMP:l "<=" /[\s\S]+/:r
    => RULE("Expr", l) \+ "str w0, [sp, #-16]!" \+ RULE("Expr", r) \+ "ldr w1, [sp], #16" \+ "cmp w1, w0" \+ "cset w0, le"
  | $NO_COMP:l "<" /[\s\S]+/:r
    => RULE("Expr", l) \+ "str w0, [sp, #-16]!" \+ RULE("Expr", r) \+ "ldr w1, [sp], #16" \+ "cmp w1, w0" \+ "cset w0, lt"
  | /[\s\S]+/:s => RULE("AddExpr", s)

AddExpr ::= $NO_ADD:l "+" "0" => RULE("Expr", l)
          | "0" "+" $NO_ADD:r => RULE("Expr", r)
          | $NO_ADD:l "-" "0" => RULE("Expr", l)
          | $NO_ADD:l "+" $NUM:r => RULE("Expr", l) \+ "add w0, w0, #" + r
          | $NO_ADD:l "-" $NUM:r => RULE("Expr", l) \+ "sub w0, w0, #" + r
          | $NO_ADD:l "+" $VAR:r => RULE("Expr", r) \+ "mov w8, w0" \+ RULE("Expr", l) \+ "add w0, w0, w8"
          | $NO_ADD:l "-" $VAR:r => RULE("Expr", r) \+ "mov w8, w0" \+ RULE("Expr", l) \+ "sub w0, w0, w8"
          | $NO_ADD:l "+" /[\s\S]+/:r => RULE("Expr", l) \+ "str w0, [sp, #-16]!" \+ RULE("Expr", r) \+ "ldr w1, [sp], #16" \+ "add w0, w1, w0"
  | $NO_ADD:l "-" /[\s\S]+/:r => RULE("Expr", l) \+ "str w0, [sp, #-16]!" \+ RULE("Expr", r) \+ "ldr w1, [sp], #16" \+ "sub w0, w1, w0"
  | /[\s\S]+/:s => RULE("MulExpr", s)

MulExpr ::= $NO_MUL:l "*" "0" => "mov w0, 0"
          | $NO_MUL:l "*" "1" => RULE("Expr", l)
          | "0" "*" $NO_MUL:r => "mov w0, 0"
          | "1" "*" $NO_MUL:r => RULE("Expr", r)
          | $NO_MUL:l "/" "1" => RULE("Expr", l)
          | "0" "/" $NO_MUL:r => "mov w0, 0"
          | $NO_MUL:l "*" "2" => RULE("Expr", l) \+ "add w0, w0, w0"
%for val, shift in [("4","2"), ("8","3")] {
          | $NO_MUL:l "*" "{val}" => RULE("Expr", l) \+ "lsl w0, w0, {shift}"
}
          | $NO_MUL:l "*" $NUM:r => RULE("Expr", r) \+ "mov w8, w0" \+ RULE("Expr", l) \+ "mul w0, w0, w8"
          | $NO_MUL:l "*" $VAR:r => RULE("Expr", r) \+ "mov w8, w0" \+ RULE("Expr", l) \+ "mul w0, w0, w8"
          | $NO_MUL:l "/" $NUM:r => RULE("Expr", r) \+ "mov w8, w0" \+ RULE("Expr", l) \+ "sdiv w0, w0, w8"
          | $NO_MUL:l "/" $VAR:r => RULE("Expr", r) \+ "mov w8, w0" \+ RULE("Expr", l) \+ "sdiv w0, w0, w8"
          | $NO_MUL:l "/" /[\s\S]+/:r => RULE("Expr", l) \+ "str w0, [sp, #-16]!" \+ RULE("Expr", r) \+ "ldr w1, [sp], #16" \+ "sdiv w0, w1, w0"
  | $NO_MUL:l "*" /[\s\S]+/:r => RULE("Expr", l) \+ "str w0, [sp, #-16]!" \+ RULE("Expr", r) \+ "ldr w1, [sp], #16" \+ "mul w0, w1, w0"
  | /[\s\S]+/:s => RULE("Primary", s)

Primary ::= "(" $PAREN:e ")" => RULE("Expr", e)
          | "&" $VAR:name => RULE("AddrOf", name)
          | "*" PtrChain:inner => inner \+ "ldr w0, [x0]"
          | "0" => "mov w0, 0"
          | $NUM:n => "mov w0, " + n
          | $VAR:name => RULE("AnnotatedVar", name)

PtrChain ::= $VAR:name => RULE("LoadQWord", name)
           | "*" PtrChain:inner => inner \+ "ldr x0, [x0]"

AnnotatedVar ::= /[^@]+/:name "@" $NUM:off => "ldr w0, [x29, #-" + off + "]"
               | $IDENT:name => "ldr w0, [x29, #-" + name + "]"

LoadQWord ::= /[^@]+/:name "@" $NUM:off => "ldr x0, [x29, #-" + off + "]"
            | $IDENT:name => "ldr x0, [x29, #-" + name + "]"

AddrOf ::= /[^@]+/:name "@" $NUM:off => "sub x0, x29, #" + off
OffOfPtr ::= /[^@]+/:name "@" $NUM:off => off

Ceil16 ::= "64" => "64" | "60" => "64" | "56" => "64" | "52" => "64"
         | "48" => "48" | "44" => "48" | "40" => "48" | "36" => "48"
         | "32" => "32" | "28" => "32" | "24" => "32" | "20" => "32"
         | "16" => "16" | "12" => "16" | "8" => "16" | "4" => "16"
         | "0" => "0" | $NUM:n => n
