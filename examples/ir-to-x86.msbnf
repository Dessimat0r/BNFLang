// Micro-IR → x86-64 assembly (macOS) (Meta-SBNF)
Program ::= /[\s\S]*/:src
    => ".data\nfmt: .asciz \"%d\\n\"\nfmtn: .asciz \"%d \"\nfmt_nl: .asciz \"\\n\"\nfmt_sp: .asciz \" \"\nfmt_2d: .asciz \"%d %d\\n\"\nfmt_3d: .asciz \"%d %d %d\\n\"\n.text\n.intel_syntax noprefix\n"
     + RULE("Lines", src)

%include "ir_common.msbnf"

@def STORE_STACK(val_asm, off):
    val_asm \+ "mov DWORD PTR [rbp-" + off + "], eax"

Line ::= "GLOBAL" $IDENT:gname $NUM:val
    => ".data\n.globl _" + gname + "\n_" + gname + ": .long " + val + "\n.text\n.intel_syntax noprefix"
  | "FUNC" $IDENT:fname => ".globl " + fname + "\n" + fname + ":"
  | "FRAME" $NUM:sz => "push rbp\nmov rbp, rsp\nsub rsp, " + sz
  | "END_FUNC" => "mov rsp, rbp\npop rbp\nret"
  | "INIT_PTR" $VAR:v "@" $NUM:off " = &" $VAR:ref "@" $NUM:ref_off => "lea rax, [rbp-" + ref_off + "]\nmov QWORD PTR [rbp-" + off + "], rax"
  | "INIT_PTR" $VAR:v "@" $NUM:off " = 0" => "mov QWORD PTR [rbp-" + off + "], 0"
  | "INIT_ZERO" $VAR:v "@" $NUM:off => "mov DWORD PTR [rbp-" + off + "], 0"
  | "INIT_VAR" $VAR:v "@" $NUM:off " = " /[\s\S]+/:val => STORE_STACK(RULE("Expr", val), off)
  | "STORE" $VAR:v "@" $NUM:off " = " /[\s\S]+/:val => STORE_STACK(RULE("Expr", val), off)
  | "LABEL" $LABEL:lbl => lbl + ":"
  | "JMP_Z" /[^\n,]+/:cond "," $LABEL:lbl => let c_asm = RULE("Expr", cond); c_asm \+ "test eax, eax" \+ "je " + lbl
  | "JMP_NZ" /[^\n,]+/:cond "," $LABEL:lbl => let c_asm = RULE("Expr", cond); c_asm \+ "test eax, eax" \+ "jne " + lbl
  | "JMP" $LABEL:lbl => "jmp " + lbl
  | "RETURN" /[\s\S]+/:val => let val_asm = RULE("Expr", val); val_asm \+ "mov rsp, rbp" \+ "pop rbp" \+ "ret"
%for i, reg in enumerate(["edi", "esi", "edx", "ecx"], 1) {
  | "PARAM{i}" $VAR:v "@" $NUM:off => "mov DWORD PTR [rbp-" + off + "], {reg}"
}
  | "STORE_GVAR" $IDENT:gname "=" /[\s\S]+/:val => let val_asm = RULE("Expr", val); val_asm \+ "mov DWORD PTR [rip + _" + gname + "], eax"
  | "STORE_PTR_VAR" "_aptr" /[^=]+/:name "=" /[\s\S]+/:val
    => let val_asm = RULE("Expr", val); let off = RULE("OffOf", "_aptr" + name); val_asm \+ "mov QWORD PTR [rbp-" + off + "], rax"
  | "STORE_DEREF" /[^\n=]+/:ptr "=" /[\s\S]+/:val
    => let p_asm = RULE("Expr", ptr); let val_asm = RULE("Expr", val); p_asm \+ "push rax" \+ val_asm \+ "pop rcx" \+ "mov DWORD PTR [rcx], eax"
  | "CALL_DEST3" $VAR:v "@" $NUM:off " = " $IDENT:func /[^ ]+/:v1 /[^ ]+/:v2 /[\s\S]+/:v3
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); let a3 = RULE("Expr", v3); a1 \+ "push rax" \+ a2 \+ "push rax" \+ a3 \+ "mov edx, eax" \+ "pop rax" \+ "mov esi, eax" \+ "pop rax" \+ "mov edi, eax" \+ "call _" + func \+ "mov DWORD PTR [rbp-" + off + "], eax"
  | "CALL_DEST2" $VAR:v "@" $NUM:off " = " $IDENT:func /[^ ]+/:v1 /[\s\S]+/:v2
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); a1 \+ "push rax" \+ a2 \+ "mov esi, eax" \+ "pop rax" \+ "mov edi, eax" \+ "call _" + func \+ "mov DWORD PTR [rbp-" + off + "], eax"
  | "CALL_DEST1" $VAR:v "@" $NUM:off " = " $IDENT:func /[\s\S]+/:v1
    => let a1 = RULE("Expr", v1); a1 \+ "mov edi, eax" \+ "call _" + func \+ "mov DWORD PTR [rbp-" + off + "], eax"
  | "CALL_DEST0" $VAR:v "@" $NUM:off " = " $IDENT:func
    => "call _" + func \+ "mov DWORD PTR [rbp-" + off + "], eax"
  | "CALL3" $IDENT:func /[^ ]+/:v1 /[^ ]+/:v2 /[\s\S]+/:v3
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); let a3 = RULE("Expr", v3); a1 \+ "push rax" \+ a2 \+ "push rax" \+ a3 \+ "mov edx, eax" \+ "pop rax" \+ "mov esi, eax" \+ "pop rax" \+ "mov edi, eax" \+ "call _" + func
  | "CALL2" $IDENT:func /[^ ]+/:v1 /[\s\S]+/:v2
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); a1 \+ "push rax" \+ a2 \+ "mov esi, eax" \+ "pop rax" \+ "mov edi, eax" \+ "call _" + func
  | "CALL1" $IDENT:func /[\s\S]+/:v1 => let a1 = RULE("Expr", v1); a1 \+ "mov edi, eax" \+ "call _" + func
  | "CALL0" $IDENT:func => "call _" + func
  | "PRINT3" $IDENT:fmt /[^ ]+/:v1 /[^ ]+/:v2 /[\s\S]+/:v3
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); let a3 = RULE("Expr", v3); a1 \+ "push rax" \+ a2 \+ "push rax" \+ a3 \+ "mov ecx, eax" \+ "pop rax" \+ "mov edx, eax" \+ "pop rax" \+ "mov esi, eax" \+ "lea rdi, [rip + " + fmt + "]" \+ "xor eax, eax" \+ "call _printf"
  | "PRINT2" $IDENT:fmt /[^ ]+/:v1 /[\s\S]+/:v2
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); a1 \+ "push rax" \+ a2 \+ "mov edx, eax" \+ "pop rax" \+ "mov esi, eax" \+ "lea rdi, [rip + " + fmt + "]" \+ "xor eax, eax" \+ "call _printf"
  | "PRINT1" $IDENT:fmt /[\s\S]+/:val
    => let a1 = RULE("Expr", val); a1 \+ "mov esi, eax" \+ "lea rdi, [rip + " + fmt + "]" \+ "xor eax, eax" \+ "call _printf"
  | "PRINT0" $IDENT:fmt => "lea rdi, [rip + " + fmt + "]" \+ "xor eax, eax" \+ "call _printf"
  | "SPRINTF3" $VAR:v "@" $NUM:off $IDENT:fmt /[^ ]+/:v1 /[^ ]+/:v2 /[\s\S]+/:v3
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); let a3 = RULE("Expr", v3); a1 \+ "push rax" \+ a2 \+ "push rax" \+ a3 \+ "mov r8, rax" \+ "pop rcx" \+ "pop rdx" \+ "lea rsi, [rip + " + fmt + "]" \+ "lea rdi, [rbp-" + off + "]" \+ "xor eax, eax" \+ "call _sprintf"
  | "SPRINTF2" $VAR:v "@" $NUM:off $IDENT:fmt /[^ ]+/:v1 /[\s\S]+/:v2
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); a1 \+ "push rax" \+ a2 \+ "mov rcx, rax" \+ "pop rdx" \+ "lea rsi, [rip + " + fmt + "]" \+ "lea rdi, [rbp-" + off + "]" \+ "xor eax, eax" \+ "call _sprintf"
  | "SPRINTF" $VAR:v "@" $NUM:off $IDENT:fmt /[\s\S]+/:val
    => let val_asm = RULE("Expr", val); val_asm \+ "mov edx, eax" \+ "lea rsi, [rip + " + fmt + "]" \+ "lea rdi, [rbp-" + off + "]" \+ "xor eax, eax" \+ "call _sprintf"
  | "none" => ""
  | /[\s]*/ => ""

OffOf ::= $VAR "@" $NUM:off /[\s\S]*/ => off | $IDENT:name /[\s\S]*/ => name

Expr ::= "(" /[^)]+/:inner ")" => RULE("OpExpr", inner)
       | /[\s\S]+/:s => RULE("PrimExpr", s)

OpExpr ::=
%for op, inst in [("AND", "and"), ("ORR", "or"), ("EOR", "xor"), ("LSL", "shl"), ("ASR", "sar")] {
    /[^ ]+/:l "{op}" /[\s\S]+/:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "mov ecx, eax" \+ "pop rax" \+ "{inst} eax, cl" |
}
%for op, cond in [("EQ", "e"), ("NE", "ne"), ("LE", "le"), ("LT", "l"), ("GE", "ge"), ("GT", "g")] {
    /[^ ]+/:l "{op}" /[\s\S]+/:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "mov ecx, eax" \+ "pop rax" \+ "cmp eax, ecx" \+ "set{cond} al" \+ "movzx eax, al" |
}
    /[^ ]+/:l "ADD" /[\s\S]+/:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "pop rcx" \+ "cdqe" \+ "add rax, rcx"
  | /[^ ]+/:l "SUB" /[\s\S]+/:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "mov ecx, eax" \+ "pop rax" \+ "sub eax, ecx"
  | /[^ ]+/:l "MUL" /[\s\S]+/:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "pop rcx" \+ "imul eax, ecx"
  | /[^ ]+/:l "DIV" /[\s\S]+/:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "mov ecx, eax" \+ "pop rax" \+ "cdq" \+ "idiv ecx"
  | /[^ ]+/:l "MOD" /[\s\S]+/:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "mov ecx, eax" \+ "pop rax" \+ "cdq" \+ "idiv ecx" \+ "mov eax, edx"
  | "NOT" /[\s\S]+/:r => RULE("Expr", r) \+ "not eax"

PrimExpr ::=
    "0" /[\s]*/ => "xor eax, eax"
  | $NUM:n => "mov eax, " + n
  | "G_" $IDENT:gname => "mov eax, DWORD PTR [rip + _G_" + gname + "]"
  | "ADDR" $VAR:v "@" $NUM:off => "lea rax, [rbp-" + off + "]"
  | "DEREF" $VAR:v "@" $NUM:off => "mov rax, [rbp-" + off + "]\nmov eax, DWORD PTR [rax]"
  | "DEREF" "DEREF" $VAR:v "@" $NUM:off => "mov rax, [rbp-" + off + "]\nmov rax, [rax]\nmov eax, DWORD PTR [rax]"
  | "CALL_VAL3" $IDENT:func /[^ ]+/:v1 /[^ ]+/:v2 /[\s\S]+/:v3
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); let a3 = RULE("Expr", v3); a1 \+ "push rax" \+ a2 \+ "push rax" \+ a3 \+ "mov edx, eax" \+ "pop rax" \+ "mov esi, eax" \+ "pop rax" \+ "mov edi, eax" \+ "call _" + func
  | "CALL_VAL2" $IDENT:func /[^ ]+/:v1 /[\s\S]+/:v2
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); a1 \+ "push rax" \+ a2 \+ "mov esi, eax" \+ "pop rax" \+ "mov edi, eax" \+ "call _" + func
  | "CALL_VAL1" $IDENT:func /[\s\S]+/:v1 => let a1 = RULE("Expr", v1); a1 \+ "mov edi, eax" \+ "call _" + func
  | "CALL_VAL0" $IDENT:func => "call _" + func
  | $VAR:v "@" $NUM:off => "mov eax, DWORD PTR [rbp-" + off + "]"
