// C-like → Micro-IR Generator (Meta-SBNF)
// Transpiles C syntax into architecture-agnostic Micro-IR (.ir)

$IDENT = /[a-zA-Z_]\w*/
$NUM = /[0-9]+/
$DECL_STATE = /[0-9]+/:n "\x00" /[^\x00]*/:i "\x00"
$DECL_HDR = /[0-9]+/:n "\x00" /[^\x00]*/:i "\x00" /(?:long\s+long|char|short|int|long|void)\s*/
$STMT_STATE = /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00"

Program ::= /[\s\S]*/:src => RULE("FuncList", src)

FuncList ::= /[^\x00]+/:f "\x00" /[\s\S]*/:rest => RULE("OneFunc", f) + "\n" + RULE("FuncList", rest)
          | /[\s\S]+/:f => RULE("OneFunc", f)

OneFunc ::= "GLOBAL " $IDENT:gname $NUM:val
    => "GLOBAL " + gname + " " + val + "\n"
  | "FUNC " $IDENT:fname "\n" /[\s\S]*/:body
    => "FUNC " + fname + "\n" + RULE("Decls", "4\x00\x00" + body)
  | /[\s\S]*/:body
    => "FUNC _main\n" + RULE("Decls", "4\x00\x00" + body)

// ── Declaration Phase ────────────────────────────────────────────────────

Decls ::= $DECL_STATE /[\s\S]*/:c => RULE("TryDecl", n + "\x00" + i + "\x00" + c)

TryDecl ::= $DECL_HDR /\*+/ $IDENT:v "=" "&" $VAR:ref ";" "\n" /[\s\S]*/:c
    => DECL(v, n, i, c, "INIT_PTR " + v + "@" + n + " = &" + ref + "\n")
  | $DECL_HDR /\*+/ $IDENT:v "=" $NUM:val ";" "\n" /[\s\S]*/:c
    => DECL(v, n, i, c, "INIT_PTR " + v + "@" + n + " = 0\n")
  | $DECL_HDR /\*+/ $IDENT:v ";" "\n" /[\s\S]*/:c => DECL(v, n, i, c, "")
  | $DECL_HDR $IDENT:v "=" "0" ";" "\n" /[\s\S]*/:c
    => let code = RULE("DeclZeroCode", v + "\x00" + n); DECL(v, n, i, c, code)
  | $DECL_HDR $IDENT:v "=" /[^;\x00]+/:val ";" "\n" /[\s\S]*/:c
    => let val_ir = RULE("Expr", val); DECL(v, n, i, c, "INIT_VAR " + v + "@" + n + " = " + val_ir + "\n")
  | $DECL_STATE /[\s\S]*/:c
    => "FRAME " + CEIL16(n + 64) + "\n"
     + i
     + RULE("Stmts", "10\x00none\x00none\x00" + c)
     + "END_FUNC\n"

DeclZeroCode ::= "buf_pad" /[\s\S]*/ => ""
               | $IDENT:v "\x00" $NUM:n => "INIT_ZERO " + v + "@" + n + "\n"

// ── Statement Phase ──────────────────────────────────────────────────────

Stmts ::= $STMT_STATE /[\s\S]*/:code => RULE("S", lc + "\x00" + cl + "\x00" + bl + "\x00" + code)

S ::= $STMT_STATE "while" "(" $PAREN:cond ")" "{" BlockBody:body "}" /[\s\S]*/:rest
    => RULE("GenWhile", lc + "\x00" + cond + "\x00" + body) + "\n" + RULE("S", (lc + "5") + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | $STMT_STATE "while" "(" $PAREN:cond ")" "{" BlockBody:body "}"
    => RULE("GenWhile", lc + "\x00" + cond + "\x00" + body)
  | $STMT_STATE "do_while" "(" $PAREN:cond ")" "{" BlockBody:body "}" /[\s\S]*/:rest
    => RULE("GenDoWhile", lc + "\x00" + cond + "\x00" + body) + "\n" + RULE("S", (lc + "5") + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | $STMT_STATE "do_while" "(" $PAREN:cond ")" "{" BlockBody:body "}"
    => RULE("GenDoWhile", lc + "\x00" + cond + "\x00" + body)
  | $STMT_STATE "if" "(" $PAREN:cond ")" "{" BlockBody:b1 "}" "else" "{" BlockBody:b2 "}" /[\s\S]*/:rest
    => RULE("GenIfElse", lc + "\x00" + cl + "\x00" + bl + "\x00" + cond + "\x00" + b1 + "\x00" + b2) + "\n" + RULE("S", (lc + "5") + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | $STMT_STATE "if" "(" $PAREN:cond ")" "{" BlockBody:b1 "}" "else" "{" BlockBody:b2 "}"
    => RULE("GenIfElse", lc + "\x00" + cl + "\x00" + bl + "\x00" + cond + "\x00" + b1 + "\x00" + b2)
  | $STMT_STATE "if" "(" $PAREN:cond ")" "{" BlockBody:body "}" /[\s\S]*/:rest
    => RULE("GenIf", lc + "\x00" + cl + "\x00" + bl + "\x00" + cond + "\x00" + body) + "\n" + RULE("S", (lc + "5") + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | $STMT_STATE "if" "(" $PAREN:cond ")" "{" BlockBody:body "}"
    => RULE("GenIf", lc + "\x00" + cl + "\x00" + bl + "\x00" + body)
  | $STMT_STATE Stmt:first "\n" /[\s\S]*/:rest
    => RULE("GenStmt", cl + "\x00" + bl + "\x00" + first) + "\n" + RULE("S", lc + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | $STMT_STATE Stmt:last => RULE("GenStmt", cl + "\x00" + bl + "\x00" + last) + "\n"
  | => ""

GenStmt ::= /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "break;" => "JMP .L" + bl
          | /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "continue;" => "JMP .L" + cl
          | /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" /[\s\S]*/:s => s

// ── C Statements Translation ─────────────────────────────────────────────

Stmt ::=
    "return" /[^;]+/:val ";" => "RETURN " + RULE("Expr", val)
  | "G_" $IDENT:gname "=" /[^;]+/:val ";"
    => let val_ir = RULE("Expr", val); "STORE_GVAR G_" + gname + " = " + val_ir
  // Function parameters
  | Var:v "=" "_param1;" => "PARAM1 " + v
  | Var:v "=" "_param2;" => "PARAM2 " + v
  | Var:v "=" "_param3;" => "PARAM3 " + v
  | Var:v "=" "_param4;" => "PARAM4 " + v
  // Function calls
  | Var:dest "=" "CALL " $IDENT:func /[^;]+/:args ";"
    => "CALL_DEST " + dest + " = " + func + " " + args
  | "CALL " $IDENT:func /[^;]+/:args ";"
    => "CALL " + func + " " + args
  | "CALL " $IDENT:func ";"
    => "CALL " + func
  // Pointers & Assignments
  | "_aptr" /[^=]+/:name "=" /[^;]+/:val ";"
    => let val_ir = RULE("Expr", val); "STORE_PTR_VAR _aptr" + name + " = " + val_ir
  | "*" PtrChain:ptr "=" /[^;]+/:val ";"
    => let val_ir = RULE("Expr", val); "STORE_DEREF " + ptr + " = " + val_ir
  | Var:name "=" /[^;]+/:val ";" => "STORE " + name + " = " + RULE("Expr", val)
  | "{" => "" | "}" => "" | /[\s]+/:ws => "" | /./:c => c

OffOf ::= $VAR_OFF /[\s\S]*/ => off | $IDENT:name /[\s\S]*/ => name

// ── Loops & Control Flow IR Emission ──────────────────────────────────────

BlockBody ::= /[^{}]+/:text BlockBody:rest => text + rest | "{" BlockBody:inner "}" BlockBody:rest => "{" + inner + "}" + rest | => ""

GenWhile ::= $NUM:lc "\x00" /[^\x00]+/:cond "\x00" /[\s\S]*/:body
    => "LABEL .L" + lc + "\n" + "JMP_Z " + RULE("Expr", cond) + ", .L" + (lc + "1") + "\n" + RULE("Stmts", (lc + "2") + "\x00" + lc + "\x00" + (lc + "1") + "\x00" + body) + "JMP .L" + lc + "\nLABEL .L" + (lc + "1")

GenDoWhile ::= $NUM:lc "\x00" /[^\x00]+/:cond "\x00" /[\s\S]*/:body
    => "LABEL .L" + lc + "\n" + RULE("Stmts", (lc + "2") + "\x00" + (lc + "3") + "\x00" + (lc + "1") + "\x00" + body) + "LABEL .L" + (lc + "3") + "\nJMP_NZ " + RULE("Expr", cond) + ", .L" + lc + "\nLABEL .L" + (lc + "1")

GenIf ::= $NUM:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" /[^\x00]+/:cond "\x00" /[\s\S]*/:body
    => "JMP_Z " + RULE("Expr", cond) + ", .L" + lc + "\n" + RULE("Stmts", (lc + "1") + "\x00" + cl + "\x00" + bl + "\x00" + body) + "LABEL .L" + lc

GenIfElse ::= $NUM:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" /[^\x00]+/:cond "\x00" /[^\x00]*/:b1 "\x00" /[\s\S]*/:b2
    => "JMP_Z " + RULE("Expr", cond) + ", .L" + lc + "\n" + RULE("Stmts", (lc + "2") + "\x00" + cl + "\x00" + bl + "\x00" + b1) + "JMP .L" + (lc + "1") + "\nLABEL .L" + lc + "\n" + RULE("Stmts", (lc + "3") + "\x00" + cl + "\x00" + bl + "\x00" + b2) + "LABEL .L" + (lc + "1")

// ── Expressions ──────────────────────────────────────────────────────────

Num ::= $NUM:n /[\s]*/ => n
Var ::= $VAR:v /[\s]*/ => v

Expr ::= /[\s\S]+/:s => RULE("BitwiseExpr", s)

BitwiseExpr ::= "~" $NO_ADD:r => "(NOT " + RULE("Expr", r) + ")"
%for op, ir_op in [("&", "AND"), ("|", "ORR"), ("^", "EOR"), ("<<", "LSL"), (">>", "ASR")] {
              | $NO_ADD:l "{op}" $NO_ADD:r => "(" + RULE("Expr", l) + " {ir_op} " + RULE("Expr", r) + ")"
}
              | /[\s\S]+/:s => RULE("Compare", s)

Compare ::=
%for op, ir_op in [("==", "EQ"), ("!=", "NE"), ("<=", "LE"), ("<", "LT"), (">=", "GE"), (">", "GT")] {
    $NO_COMP:l "{op}" $NO_COMP:r => "(" + RULE("Expr", l) + " {ir_op} " + RULE("Expr", r) + ")" |
}
    /[\s\S]+/:s => RULE("AddExpr", s)

AddExpr ::= $NO_ADD:l /[+-]/ "0" => RULE("Expr", l)
          | "0" "+" $NO_ADD:r => RULE("Expr", r)
          | $NO_ADD:l "+" /[\s\S]+/:r => "(" + RULE("Expr", l) + " ADD " + RULE("Expr", r) + ")"
          | $NO_ADD:l "-" /[\s\S]+/:r => "(" + RULE("Expr", l) + " SUB " + RULE("Expr", r) + ")"
          | /[\s\S]+/:s => RULE("MulExpr", s)

MulExpr ::= $NO_MUL:l "*" "0" => "0"
          | "0" /[*/]/ $NO_MUL:r => "0"
          | $NO_MUL:l /[*/]/ "1" => RULE("Expr", l)
          | "1" "*" $NO_MUL:r => RULE("Expr", r)
          | $NO_MUL:l "%" $NO_ADD:r => "(" + RULE("Expr", l) + " MOD " + RULE("Expr", r) + ")"
          | $NO_MUL:l "*" $NO_ADD:r => "(" + RULE("Expr", l) + " MUL " + RULE("Expr", r) + ")"
          | $NO_MUL:l "/" $NO_ADD:r => "(" + RULE("Expr", l) + " DIV " + RULE("Expr", r) + ")"
          | /[\s\S]+/:s => RULE("Primary", s)

Primary ::= "(" $PAREN:e ")" /[\s]*/ => RULE("Expr", e)
          | "&" Var:name => "ADDR " + name
          | "*" PtrChain:inner => "DEREF " + inner
          | "CALL " $IDENT:func /[^)\x00\s]+/:args => "CALL_VAL " + func + " " + args
          | "CALL " $IDENT:func => "CALL_VAL " + func
          | "0" /[\s]*/ => "0"
          | Num:n => n
          | "G_" $IDENT:gname /[\s]*/ => "G_" + gname
          | Var:name => name

PtrChain ::= Var:name => name | "*" PtrChain:inner => "DEREF " + inner
