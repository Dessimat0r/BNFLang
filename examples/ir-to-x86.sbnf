// Micro-IR → x86-64 assembly (macOS) (Meta-SBNF)
Program ::= /[\s\S]*/:src
    => ".data\nfmt: .asciz \"%d\\n\"\nfmtn: .asciz \"%d \"\nfmt_nl: .asciz \"\\n\"\nfmt_sp: .asciz \" \"\nfmt_2d: .asciz \"%d %d\\n\"\nfmt_3d: .asciz \"%d %d %d\\n\"\n.text\n.intel_syntax noprefix\n"
     + RULE("Lines", src)

// Shared Micro-IR Tokens & Boilerplate (Meta-SBNF)

Lines ::= /[^\n]+/:l "\n" /[\s\S]*/:rest => RULE("Line", l) + "\n" + RULE("Lines", rest)
       | /[^\n]+/:l => RULE("Line", l)
       | => ""


@def STORE_STACK(val_asm, off):
    val_asm + "\n" + "mov DWORD PTR [rbp-" + off + "], eax"

Line ::= "GLOBAL" /[a-zA-Z_]\w*/:gname /[0-9]+/:val
    => ".data\n.globl _" + gname + "\n_" + gname + ": .long " + val + "\n.text\n.intel_syntax noprefix"
  | "FUNC" /[a-zA-Z_]\w*/:fname => ".globl " + fname + "\n" + fname + ":"
  | "FRAME" /[0-9]+/:sz => "push rbp\nmov rbp, rsp\nsub rsp, " + sz
  | "END_FUNC" => "mov rsp, rbp\npop rbp\nret"
  | "INIT_PTR" /[^@]+/:v "@" /[0-9]+/:off " = &" /[^@]+/:ref "@" /[0-9]+/:ref_off => "lea rax, [rbp-" + ref_off + "]\nmov QWORD PTR [rbp-" + off + "], rax"
  | "INIT_PTR" /[^@]+/:v "@" /[0-9]+/:off " = 0" => "mov QWORD PTR [rbp-" + off + "], 0"
  | "INIT_ZERO" /[^@]+/:v "@" /[0-9]+/:off => "mov DWORD PTR [rbp-" + off + "], 0"
  | "INIT_VAR" /[^@]+/:v "@" /[0-9]+/:off " = " /[\s\S]+/:val => STORE_STACK(RULE("Expr", val), off)
  | "STORE" /[^@]+/:v "@" /[0-9]+/:off " = " /[\s\S]+/:val => STORE_STACK(RULE("Expr", val), off)
  | "LABEL" /[.\w]+/:lbl => lbl + ":"
  | "JMP_Z" /[^\n,]+/:cond "," /[.\w]+/:lbl => LET(c_asm, RULE("Expr", cond), c_asm + "\n" + "test eax, eax" + "\n" + "je " + lbl)
  | "JMP_NZ" /[^\n,]+/:cond "," /[.\w]+/:lbl => LET(c_asm, RULE("Expr", cond), c_asm + "\n" + "test eax, eax" + "\n" + "jne " + lbl)
  | "JMP" /[.\w]+/:lbl => "jmp " + lbl
  | "RETURN" /[\s\S]+/:val => LET(val_asm, RULE("Expr", val), val_asm + "\n" + "mov rsp, rbp" + "\n" + "pop rbp" + "\n" + "ret")
%for i, reg in enumerate(["edi", "esi", "edx", "ecx"], 1) {
  | "PARAM{i}" /[^@]+/:v "@" /[0-9]+/:off => "mov DWORD PTR [rbp-" + off + "], {reg}"
}
  | "STORE_GVAR" /[a-zA-Z_]\w*/:gname "=" /[\s\S]+/:val => LET(val_asm, RULE("Expr", val), val_asm + "\n" + "mov DWORD PTR [rip + _" + gname + "], eax")
  | "STORE_PTR_VAR" "_aptr" /[^=]+/:name "=" /[\s\S]+/:val
    => LET(val_asm, RULE("Expr", val), LET(off, RULE("OffOf", "_aptr" + name), val_asm + "\n" + "mov QWORD PTR [rbp-" + off + "], rax"))
  | "STORE_DEREF" /[^\n=]+/:ptr "=" /[\s\S]+/:val
    => LET(p_asm, RULE("Expr", ptr), LET(val_asm, RULE("Expr", val), p_asm + "\n" + "push rax" + "\n" + val_asm + "\n" + "pop rcx" + "\n" + "mov DWORD PTR [rcx], eax"))
  | "CALL_DEST3" /[^@]+/:v "@" /[0-9]+/:off " = " /[a-zA-Z_]\w*/:func /[^ ]+/:v1 /[^ ]+/:v2 /[\s\S]+/:v3
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), LET(a3, RULE("Expr", v3), a1 + "\n" + "push rax" + "\n" + a2 + "\n" + "push rax" + "\n" + a3 + "\n" + "mov edx, eax" + "\n" + "pop rax" + "\n" + "mov esi, eax" + "\n" + "pop rax" + "\n" + "mov edi, eax" + "\n" + "call _" + func + "\n" + "mov DWORD PTR [rbp-" + off + "], eax")))
  | "CALL_DEST2" /[^@]+/:v "@" /[0-9]+/:off " = " /[a-zA-Z_]\w*/:func /[^ ]+/:v1 /[\s\S]+/:v2
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), a1 + "\n" + "push rax" + "\n" + a2 + "\n" + "mov esi, eax" + "\n" + "pop rax" + "\n" + "mov edi, eax" + "\n" + "call _" + func + "\n" + "mov DWORD PTR [rbp-" + off + "], eax"))
  | "CALL_DEST1" /[^@]+/:v "@" /[0-9]+/:off " = " /[a-zA-Z_]\w*/:func /[\s\S]+/:v1
    => LET(a1, RULE("Expr", v1), a1 + "\n" + "mov edi, eax" + "\n" + "call _" + func + "\n" + "mov DWORD PTR [rbp-" + off + "], eax")
  | "CALL_DEST0" /[^@]+/:v "@" /[0-9]+/:off " = " /[a-zA-Z_]\w*/:func
    => "call _" + func + "\n" + "mov DWORD PTR [rbp-" + off + "], eax"
  | "CALL3" /[a-zA-Z_]\w*/:func /[^ ]+/:v1 /[^ ]+/:v2 /[\s\S]+/:v3
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), LET(a3, RULE("Expr", v3), a1 + "\n" + "push rax" + "\n" + a2 + "\n" + "push rax" + "\n" + a3 + "\n" + "mov edx, eax" + "\n" + "pop rax" + "\n" + "mov esi, eax" + "\n" + "pop rax" + "\n" + "mov edi, eax" + "\n" + "call _" + func)))
  | "CALL2" /[a-zA-Z_]\w*/:func /[^ ]+/:v1 /[\s\S]+/:v2
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), a1 + "\n" + "push rax" + "\n" + a2 + "\n" + "mov esi, eax" + "\n" + "pop rax" + "\n" + "mov edi, eax" + "\n" + "call _" + func))
  | "CALL1" /[a-zA-Z_]\w*/:func /[\s\S]+/:v1 => LET(a1, RULE("Expr", v1), a1 + "\n" + "mov edi, eax" + "\n" + "call _" + func)
  | "CALL0" /[a-zA-Z_]\w*/:func => "call _" + func
  | "PRINT3" /[a-zA-Z_]\w*/:fmt /[^ ]+/:v1 /[^ ]+/:v2 /[\s\S]+/:v3
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), LET(a3, RULE("Expr", v3), a1 + "\n" + "push rax" + "\n" + a2 + "\n" + "push rax" + "\n" + a3 + "\n" + "mov ecx, eax" + "\n" + "pop rax" + "\n" + "mov edx, eax" + "\n" + "pop rax" + "\n" + "mov esi, eax" + "\n" + "lea rdi, [rip + " + fmt + "]" + "\n" + "xor eax, eax" + "\n" + "call _printf")))
  | "PRINT2" /[a-zA-Z_]\w*/:fmt /[^ ]+/:v1 /[\s\S]+/:v2
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), a1 + "\n" + "push rax" + "\n" + a2 + "\n" + "mov edx, eax" + "\n" + "pop rax" + "\n" + "mov esi, eax" + "\n" + "lea rdi, [rip + " + fmt + "]" + "\n" + "xor eax, eax" + "\n" + "call _printf"))
  | "PRINT1" /[a-zA-Z_]\w*/:fmt /[\s\S]+/:val
    => LET(a1, RULE("Expr", val), a1 + "\n" + "mov esi, eax" + "\n" + "lea rdi, [rip + " + fmt + "]" + "\n" + "xor eax, eax" + "\n" + "call _printf")
  | "PRINT0" /[a-zA-Z_]\w*/:fmt => "lea rdi, [rip + " + fmt + "]" + "\n" + "xor eax, eax" + "\n" + "call _printf"
  | "SPRINTF3" /[^@]+/:v "@" /[0-9]+/:off /[a-zA-Z_]\w*/:fmt /[^ ]+/:v1 /[^ ]+/:v2 /[\s\S]+/:v3
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), LET(a3, RULE("Expr", v3), a1 + "\n" + "push rax" + "\n" + a2 + "\n" + "push rax" + "\n" + a3 + "\n" + "mov r8, rax" + "\n" + "pop rcx" + "\n" + "pop rdx" + "\n" + "lea rsi, [rip + " + fmt + "]" + "\n" + "lea rdi, [rbp-" + off + "]" + "\n" + "xor eax, eax" + "\n" + "call _sprintf")))
  | "SPRINTF2" /[^@]+/:v "@" /[0-9]+/:off /[a-zA-Z_]\w*/:fmt /[^ ]+/:v1 /[\s\S]+/:v2
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), a1 + "\n" + "push rax" + "\n" + a2 + "\n" + "mov rcx, rax" + "\n" + "pop rdx" + "\n" + "lea rsi, [rip + " + fmt + "]" + "\n" + "lea rdi, [rbp-" + off + "]" + "\n" + "xor eax, eax" + "\n" + "call _sprintf"))
  | "SPRINTF" /[^@]+/:v "@" /[0-9]+/:off /[a-zA-Z_]\w*/:fmt /[\s\S]+/:val
    => LET(val_asm, RULE("Expr", val), val_asm + "\n" + "mov edx, eax" + "\n" + "lea rsi, [rip + " + fmt + "]" + "\n" + "lea rdi, [rbp-" + off + "]" + "\n" + "xor eax, eax" + "\n" + "call _sprintf")
  | "none" => ""
  | /[\s]*/ => ""

OffOf ::= /[^@]+/ "@" /[0-9]+/:off /[\s\S]*/ => off | /[a-zA-Z_]\w*/:name /[\s\S]*/ => name

Expr ::= "(" /[^)]+/:inner ")" => RULE("OpExpr", inner)
       | /[\s\S]+/:s => RULE("PrimExpr", s)

OpExpr ::=
    /[^ ]+/:l "AND" /[\s\S]+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "mov ecx, eax" + "\n" + "pop rax" + "\n" + "and eax, cl" |
    /[^ ]+/:l "ORR" /[\s\S]+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "mov ecx, eax" + "\n" + "pop rax" + "\n" + "or eax, cl" |
    /[^ ]+/:l "EOR" /[\s\S]+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "mov ecx, eax" + "\n" + "pop rax" + "\n" + "xor eax, cl" |
    /[^ ]+/:l "LSL" /[\s\S]+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "mov ecx, eax" + "\n" + "pop rax" + "\n" + "shl eax, cl" |
    /[^ ]+/:l "ASR" /[\s\S]+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "mov ecx, eax" + "\n" + "pop rax" + "\n" + "sar eax, cl" |
    /[^ ]+/:l "EQ" /[\s\S]+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "mov ecx, eax" + "\n" + "pop rax" + "\n" + "cmp eax, ecx" + "\n" + "sete al" + "\n" + "movzx eax, al" |
    /[^ ]+/:l "NE" /[\s\S]+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "mov ecx, eax" + "\n" + "pop rax" + "\n" + "cmp eax, ecx" + "\n" + "setne al" + "\n" + "movzx eax, al" |
    /[^ ]+/:l "LE" /[\s\S]+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "mov ecx, eax" + "\n" + "pop rax" + "\n" + "cmp eax, ecx" + "\n" + "setle al" + "\n" + "movzx eax, al" |
    /[^ ]+/:l "LT" /[\s\S]+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "mov ecx, eax" + "\n" + "pop rax" + "\n" + "cmp eax, ecx" + "\n" + "setl al" + "\n" + "movzx eax, al" |
    /[^ ]+/:l "GE" /[\s\S]+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "mov ecx, eax" + "\n" + "pop rax" + "\n" + "cmp eax, ecx" + "\n" + "setge al" + "\n" + "movzx eax, al" |
    /[^ ]+/:l "GT" /[\s\S]+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "mov ecx, eax" + "\n" + "pop rax" + "\n" + "cmp eax, ecx" + "\n" + "setg al" + "\n" + "movzx eax, al" |
    /[^ ]+/:l "ADD" /[\s\S]+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "pop rcx" + "\n" + "cdqe" + "\n" + "add rax, rcx"
  | /[^ ]+/:l "SUB" /[\s\S]+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "mov ecx, eax" + "\n" + "pop rax" + "\n" + "sub eax, ecx"
  | /[^ ]+/:l "MUL" /[\s\S]+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "pop rcx" + "\n" + "imul eax, ecx"
  | /[^ ]+/:l "DIV" /[\s\S]+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "mov ecx, eax" + "\n" + "pop rax" + "\n" + "cdq" + "\n" + "idiv ecx"
  | /[^ ]+/:l "MOD" /[\s\S]+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "mov ecx, eax" + "\n" + "pop rax" + "\n" + "cdq" + "\n" + "idiv ecx" + "\n" + "mov eax, edx"
  | "NOT" /[\s\S]+/:r => RULE("Expr", r) + "\n" + "not eax"

PrimExpr ::=
    "0" /[\s]*/ => "xor eax, eax"
  | /[0-9]+/:n => "mov eax, " + n
  | "G_" /[a-zA-Z_]\w*/:gname => "mov eax, DWORD PTR [rip + _G_" + gname + "]"
  | "ADDR" /[^@]+/:v "@" /[0-9]+/:off => "lea rax, [rbp-" + off + "]"
  | "DEREF" /[^@]+/:v "@" /[0-9]+/:off => "mov rax, [rbp-" + off + "]\nmov eax, DWORD PTR [rax]"
  | "DEREF" "DEREF" /[^@]+/:v "@" /[0-9]+/:off => "mov rax, [rbp-" + off + "]\nmov rax, [rax]\nmov eax, DWORD PTR [rax]"
  | "CALL_VAL3" /[a-zA-Z_]\w*/:func /[^ ]+/:v1 /[^ ]+/:v2 /[\s\S]+/:v3
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), LET(a3, RULE("Expr", v3), a1 + "\n" + "push rax" + "\n" + a2 + "\n" + "push rax" + "\n" + a3 + "\n" + "mov edx, eax" + "\n" + "pop rax" + "\n" + "mov esi, eax" + "\n" + "pop rax" + "\n" + "mov edi, eax" + "\n" + "call _" + func)))
  | "CALL_VAL2" /[a-zA-Z_]\w*/:func /[^ ]+/:v1 /[\s\S]+/:v2
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), a1 + "\n" + "push rax" + "\n" + a2 + "\n" + "mov esi, eax" + "\n" + "pop rax" + "\n" + "mov edi, eax" + "\n" + "call _" + func))
  | "CALL_VAL1" /[a-zA-Z_]\w*/:func /[\s\S]+/:v1 => LET(a1, RULE("Expr", v1), a1 + "\n" + "mov edi, eax" + "\n" + "call _" + func)
  | "CALL_VAL0" /[a-zA-Z_]\w*/:func => "call _" + func
  | /[^@]+/:v "@" /[0-9]+/:off => "mov eax, DWORD PTR [rbp-" + off + "]"
