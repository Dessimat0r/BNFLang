// C-like → x86-64 asm (Meta-SBNF)
// Engine: PEG + LET RULE REPLACE.
// Precedence: Bitwise > Compare > AddExpr > MulExpr > Primary

$IDENT = /[a-zA-Z_]\w*/
$DECL_HDR = $NUM:n "\x00" /[^\x00]*/:i "\x00" /(?:long\s+long|char|short|int|long|void)\s*/

Program ::= /[\s\S]*/:src => RULE("Decls", "4\x00\x00" + src)

// ── Declaration phase ─────────────────────────────────────────────────────

Decls ::= $NUM:n "\x00" /[^\x00]*/:i "\x00" /[\s\S]*/:c => RULE("TryDecl", n + "\x00" + i + "\x00" + c)

TryDecl ::= $DECL_HDR /\*+/ $IDENT:v "=" "&" $VAR:ref ";" "\n" /[\s\S]*/:c
    => DECL(v, n, i, c, "lea rax, [rbp-" + RULE("OffOf", ref) + "]" \+ "mov QWORD PTR [rbp-" + n + "], rax" \+ "")
  | $DECL_HDR /\*+/ $IDENT:v ";" "\n" /[\s\S]*/:c => DECL(v, n, i, c, "")
  | $DECL_HDR $IDENT:v "=" $NUM:val ";" "\n" /[\s\S]*/:c => DECL(v, n, i, c, "mov DWORD PTR [rbp-" + n + "], " + val \+ "")
  | $DECL_HDR $IDENT:v "=" /[^;\x00]+/:val ";" "\n" /[\s\S]*/:c
    => let val_asm = RULE("Expr", val); DECL(v, n, i, c, val_asm \+ "mov DWORD PTR [rbp-" + n + "], eax" \+ "")
  | $NUM:n "\x00" /[^\x00]*/:i "\x00" /[\s\S]*/:c
    => ".data\nfmt: .asciz \"%d\\n\"\nfmtn: .asciz \"%d \"\nfmt_nl: .asciz \"\\n\"\nfmt_sp: .asciz \" \"\nfmt_2d: .asciz \"%d %d\\n\"\nfmt_3d: .asciz \"%d %d %d\\n\"\n"
     + ".text\n.globl _main\n.intel_syntax noprefix\n"
     + "_main:\npush rbp\nmov rbp, rsp\nsub rsp, " + n + "\n"
     + i
     + RULE("Stmts", "10\x00none\x00none\x00" + c)
     + "mov rsp, rbp\npop rbp\nret\n"

// ── Statement phase ──────────────────────────────────────────────────────

Stmts ::= $NUM:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" /[\s\S]*/:code => RULE("S", lc + "\x00" + cl + "\x00" + bl + "\x00" + code)

S ::= $NUM:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "while" "(" $PAREN:cond ")" "{" BlockBody:body "}" /[\s\S]*/:rest
    => RULE("GenWhile", lc + "\x00" + cond + "\x00" + body) + "\n" + RULE("S", (lc + "5") + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | $NUM:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "while" "(" $PAREN:cond ")" "{" BlockBody:body "}"
    => RULE("GenWhile", lc + "\x00" + cond + "\x00" + body)
  | $NUM:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "do_while" "(" $PAREN:cond ")" "{" BlockBody:body "}" /[\s\S]*/:rest
    => RULE("GenDoWhile", lc + "\x00" + cond + "\x00" + body) + "\n" + RULE("S", (lc + "5") + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | $NUM:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "do_while" "(" $PAREN:cond ")" "{" BlockBody:body "}"
    => RULE("GenDoWhile", lc + "\x00" + cond + "\x00" + body)
  | $NUM:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "if" "(" $PAREN:cond ")" "{" BlockBody:b1 "}" "else" "{" BlockBody:b2 "}" /[\s\S]*/:rest
    => RULE("GenIfElse", lc + "\x00" + cl + "\x00" + bl + "\x00" + cond + "\x00" + b1 + "\x00" + b2) + "\n" + RULE("S", (lc + "5") + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | $NUM:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "if" "(" $PAREN:cond ")" "{" BlockBody:b1 "}" "else" "{" BlockBody:b2 "}"
    => RULE("GenIfElse", lc + "\x00" + cl + "\x00" + bl + "\x00" + cond + "\x00" + b1 + "\x00" + b2)
  | $NUM:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "if" "(" $PAREN:cond ")" "{" BlockBody:body "}" /[\s\S]*/:rest
    => RULE("GenIf", lc + "\x00" + cl + "\x00" + bl + "\x00" + cond + "\x00" + body) + "\n" + RULE("S", (lc + "5") + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | $NUM:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "if" "(" $PAREN:cond ")" "{" BlockBody:body "}"
    => RULE("GenIf", lc + "\x00" + cl + "\x00" + bl + "\x00" + cond + "\x00" + body)
  | $NUM:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" Stmt:first "\n" /[\s\S]*/:rest
    => RULE("GenStmt", cl + "\x00" + bl + "\x00" + first) + "\n" + RULE("S", lc + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | $NUM:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" Stmt:last => RULE("GenStmt", cl + "\x00" + bl + "\x00" + last) + "\n"
  | => ""

GenStmt ::= /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "break;" => "jmp .L" + bl
          | /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "continue;" => "jmp .L" + cl
          | /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" /[\s\S]*/:s => s

Stmt ::=
    "break;" => "break;"
  | "continue;" => "continue;"
  | "print3" Var:v1 Var:v2 Var:v3 ";"
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); let a3 = RULE("Expr", v3); a1 \+ "mov esi, eax" \+ a2 \+ "mov edx, eax" \+ a3 \+ "mov ecx, eax" \+ "lea rdi, [rip + fmt_3d]" \+ "xor eax, eax" \+ "call _printf"
  | "print2" Var:v1 Var:v2 ";"
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); a1 \+ "mov esi, eax" \+ a2 \+ "mov edx, eax" \+ "lea rdi, [rip + fmt_2d]" \+ "xor eax, eax" \+ "call _printf"
  | "sprintf3" Var:buf Var:v1 Var:v2 Var:v3 ";"
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); let a3 = RULE("Expr", v3); let buf_off = RULE("OffOf", buf + "\x00" + v1); "lea rdi, [rbp-" + buf_off + "]" \+ "lea rsi, [rip + fmt_3d]" \+ a1 \+ "mov edx, eax" \+ a2 \+ "mov ecx, eax" \+ a3 \+ "mov r8d, eax" \+ "xor eax, eax" \+ "call _sprintf"
  | "sprintf2" Var:buf Var:v1 Var:v2 ";"
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); let buf_off = RULE("OffOf", buf + "\x00" + v1); "lea rdi, [rbp-" + buf_off + "]" \+ "lea rsi, [rip + fmt_2d]" \+ a1 \+ "mov edx, eax" \+ a2 \+ "mov ecx, eax" \+ "xor eax, eax" \+ "call _sprintf"
  | "sprintf" Var:buf Var:val ";"
    => let val_asm = RULE("Expr", val); let buf_off = RULE("OffOf", buf + "\x00" + val); "lea rdi, [rbp-" + buf_off + "]" \+ "lea rsi, [rip + fmt]" \+ val_asm \+ "mov edx, eax" \+ "xor eax, eax" \+ "call _sprintf"
%for kw, fmt in [("println", "fmt_nl"), ("printsp", "fmt_sp")] {
  | "{kw}" ";" => "lea rdi, [rip + {fmt}]" \+ "xor eax, eax" \+ "call _printf"
}
%for kw, fmt in [("printn", "fmtn"), ("print", "fmt")] {
  | "{kw}" /[^;]+/:val ";" => RULE("Expr", val) \+ "mov esi, eax" \+ "lea rdi, [rip + {fmt}]" \+ "xor eax, eax" \+ "call _printf"
}
  | "*" PtrChain:ptr "=" /[^;]+/:val ";"
    => let val_asm = RULE("Expr", val); ptr \+ "push rax" \+ val_asm \+ "pop rcx" \+ "mov DWORD PTR [rcx], eax"
  | Var:name "=" /[^;]+/:val ";" => let off = RULE("OffOf", name + "\x00" + val); RULE("Expr", val) \+ "mov DWORD PTR [rbp-" + off + "], eax"
  | "{" => "" | "}" => "" | /[\s]+/:ws => "" | /./:c => c

OffOf ::= $VAR_OFF /[\s\S]*/ => off | $IDENT:name /[\s\S]*/ => name

// ── Loops and conditionals ───────────────────────────────────────────────

BlockBody ::= /[^{}]+/:text BlockBody:rest => text + rest | "{" BlockBody:inner "}" BlockBody:rest => "{" + inner + "}" + rest | => ""

GenWhile ::= $NUM:lc "\x00" /[^\x00]+/:cond "\x00" /[\s\S]*/:body
    => ".L" + lc + ":\n" + RULE("Expr", cond) \+ "test eax, eax" \+ "je .L" + (lc + "1") \+ RULE("Stmts", (lc + "2") + "\x00" + lc + "\x00" + (lc + "1") + "\x00" + body) \+ "jmp .L" + lc \+ ".L" + (lc + "1") + ":\n"

GenDoWhile ::= $NUM:lc "\x00" /[^\x00]+/:cond "\x00" /[\s\S]*/:body
    => ".L" + lc + ":\n" + RULE("Stmts", (lc + "2") + "\x00" + (lc + "3") + "\x00" + (lc + "1") + "\x00" + body) \+ ".L" + (lc + "3") + ":\n" + RULE("Expr", cond) \+ "test eax, eax" \+ "jne .L" + lc \+ ".L" + (lc + "1") + ":\n"

GenIf ::= $NUM:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" /[^\x00]+/:cond "\x00" /[\s\S]*/:body
    => RULE("Expr", cond) \+ "test eax, eax" \+ "je .L" + lc \+ RULE("Stmts", (lc + "1") + "\x00" + cl + "\x00" + bl + "\x00" + body) \+ ".L" + lc + ":\n"

GenIfElse ::= $NUM:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" /[^\x00]+/:cond "\x00" /[^\x00]*/:b1 "\x00" /[\s\S]*/:b2
    => RULE("Expr", cond) \+ "test eax, eax" \+ "je .L" + lc \+ RULE("Stmts", (lc + "2") + "\x00" + cl + "\x00" + bl + "\x00" + b1) \+ "jmp .L" + (lc + "1") \+ ".L" + lc + ":\n" + RULE("Stmts", (lc + "3") + "\x00" + cl + "\x00" + bl + "\x00" + b2) \+ ".L" + (lc + "1") + ":\n"

// ── Expression rules (BitwiseExpr > Compare > AddExpr > MulExpr > Primary) ──

Num ::= $NUM:n /[\s]*/ => n
Var ::= $VAR:v /[\s]*/ => v

Expr ::= /[\s\S]+/:s => RULE("BitwiseExpr", s)

BitwiseExpr ::= "~" $NO_ADD:r => RULE("Expr", r) \+ "not eax"
%for op, inst in [("&", "and"), ("|", "or"), ("^", "xor")] {
              | $NO_ADD:l "{op}" $NO_ADD:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "pop rcx" \+ "{inst} eax, ecx"
}
%for op, inst in [("<<", "shl"), (">>", "sar")] {
              | $NO_ADD:l "{op}" $NO_ADD:r => RULE("Expr", r) \+ "mov ecx, eax" \+ RULE("Expr", l) \+ "{inst} eax, cl"
}
              | /[\s\S]+/:s => RULE("Compare", s)

Compare ::=
%for op, cond in [("==", "e"), ("!=", "ne"), ("<=", "le"), ("<", "l"), (">=", "ge"), (">", "g")] {
    $NO_COMP:l "{op}" $NO_COMP:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "pop rcx" \+ "cmp ecx, eax" \+ "set{cond} al" \+ "movzx eax, al"
  |
}
    /[\s\S]+/:s => RULE("AddExpr", s)

AddExpr ::= $NO_ADD:l /[+-]/ "0" => RULE("Expr", l)
          | "0" "+" $NO_ADD:r => RULE("Expr", r)
          | $NO_ADD:l "+" /[\s\S]+/:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "pop rcx" \+ "add eax, ecx"
          | $NO_ADD:l "-" /[\s\S]+/:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "mov ecx, eax" \+ "pop rax" \+ "sub eax, ecx"
          | /[\s\S]+/:s => RULE("MulExpr", s)

MulExpr ::= $NO_MUL:l "*" "0" => "xor eax, eax"
          | "0" /[*/]/ $NO_MUL:r => "xor eax, eax"
          | $NO_MUL:l /[*/]/ "1" => RULE("Expr", l)
          | "1" "*" $NO_MUL:r => RULE("Expr", r)
          | $NO_MUL:l "%" $NO_ADD:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "mov ecx, eax" \+ "pop rax" \+ "cdq" \+ "idiv ecx" \+ "mov eax, edx"
          | $NO_MUL:l "*" $NO_ADD:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "pop rcx" \+ "imul eax, ecx"
          | $NO_MUL:l "/" $NO_ADD:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "mov ecx, eax" \+ "pop rax" \+ "cdq" \+ "idiv ecx"
          | /[\s\S]+/:s => RULE("Primary", s)

Primary ::= "(" $PAREN:e ")" /[\s]*/ => RULE("Expr", e)
          | "&" Var:name => RULE("AddrOf", name)
          | "*" PtrChain:inner => inner \+ "mov eax, [rax]"
          | "0" /[\s]*/ => "xor eax, eax"
          | Num:n => "mov eax, " + n
          | Var:name => RULE("AnnotatedVar", name)

PtrChain ::= Var:name => RULE("LoadQWord", name) | "*" PtrChain:inner => inner \+ "mov rax, [rax]"

AnnotatedVar ::= $VAR_OFF /[\s\S]*/ => "mov eax, DWORD PTR [rbp-" + off + "]" | $IDENT:name /[\s\S]*/ => "mov eax, DWORD PTR [rbp-" + name + "]"
LoadQWord    ::= $VAR_OFF /[\s\S]*/ => "mov rax, QWORD PTR [rbp-" + off + "]" | $IDENT:name /[\s\S]*/ => "mov rax, QWORD PTR [rbp-" + name + "]"
AddrOf       ::= $VAR_OFF /[\s\S]*/ => "lea rax, [rbp-" + off + "]"
