// C-like → x86-64 asm (Meta-SBNF)
// Engine: PEG + LET RULE REPLACE.
// Operators: + - * / < <=

$IDENT = /[a-zA-Z_]\w*/

Program ::= /[\s\S]*/:src
    => RULE("Decls", "4\x00\x00" + src)

// ── Declaration phase ─────────────────────────────────────────────────────

Decls ::= $NUM:n "\x00" /[^\x00]*/:i "\x00" /[\s\S]*/:c
    => RULE("TryDecl", n + "\x00" + i + "\x00" + c)

TryDecl ::= $NUM:n "\x00" /[^\x00]*/:i "\x00int " "*" $IDENT:v "=" "&" $VAR:ref ";" "\n" /[\s\S]*/:c
    => let new_n = n + "8";
       let ref_off = RULE("OffOfPtr", ref);
       let anno = v + "@" + n;
       let new_i = i + "lea rax, [rbp-" + ref_off + "]\nmov QWORD PTR [rbp-" + n + "], rax\n";
       RULE("Decls", new_n + "\x00" + new_i + "\x00" + REPLACE(v, anno, c))
  | $NUM:n "\x00" /[^\x00]*/:i "\x00int " "*" "*" $IDENT:v "=" "&" $VAR:ref ";" "\n" /[\s\S]*/:c
    => let new_n = n + "8";
       let ref_off = RULE("OffOfPtr", ref);
       let anno = v + "@" + n;
       let new_i = i + "lea rax, [rbp-" + ref_off + "]\nmov QWORD PTR [rbp-" + n + "], rax\n";
       RULE("Decls", new_n + "\x00" + new_i + "\x00" + REPLACE(v, anno, c))
  | $NUM:n "\x00" /[^\x00]*/:i "\x00int " "*" $IDENT:v ";" "\n" /[\s\S]*/:c
    => let new_n = n + "8";
       let anno = v + "@" + n;
       RULE("Decls", new_n + "\x00" + i + "\x00" + REPLACE(v, anno, c))
  | $NUM:n "\x00" /[^\x00]*/:i "\x00int " $IDENT:v "=" $NUM:val ";" "\n" /[\s\S]*/:c
    => let new_n = n + "8";
       let anno = v + "@" + n;
       let new_i = i + "mov DWORD PTR [rbp-" + n + "], " + val + "\n";
       RULE("Decls", new_n + "\x00" + new_i + "\x00" + REPLACE(v, anno, c))
  | $NUM:n "\x00" /[^\x00]*/:i "\x00int " $IDENT:v "=" /[^;\x00]+/:val ";" "\n" /[\s\S]*/:c
    => let new_n = n + "8";
       let anno = v + "@" + n;
       let new_i = i + "mov eax, " + val + "\nmov DWORD PTR [rbp-" + n + "], eax\n";
       RULE("Decls", new_n + "\x00" + new_i + "\x00" + REPLACE(v, anno, c))
  | $NUM:n "\x00" /[^\x00]*/:i "\x00" /[\s\S]*/:c
    => ".data\nfmt: .asciz \"%d\\n\"\nfmtn: .asciz \"%d \"\nfmt_nl: .asciz \"\\n\"\nfmt_sp: .asciz \" \"\n"
     + ".text\n.globl _main\n.intel_syntax noprefix\n"
     + "_main:\npush rbp\nmov rbp, rsp\nsub rsp, " + n + "\n"
     + i
     + RULE("Stmts", "0\x00" + c)
     + "mov rsp, rbp\npop rbp\nret\n"

// ── Statement phase ──────────────────────────────────────────────────────

Stmts ::= $NUM:lc "\x00" /[\s\S]*/:code
    => RULE("S", lc + "\x00" + code)

S ::= $NUM:lc "\x00" "while" "(" $PAREN:cond ")" "{" WhileBody:body "}" /[\s\S]*/:rest
    => RULE("GenWhile", lc + "\x00" + cond + "\x00" + body) + "\n" + RULE("S", (lc + "2") + "\x00" + rest)
  | $NUM:lc "\x00" "while" "(" $PAREN:cond ")" "{" WhileBody:body "}"
    => RULE("GenWhile", lc + "\x00" + cond + "\x00" + body)
  | $NUM:lc "\x00" Stmt:first "\n" /[\s\S]*/:rest
    => first + "\n" + RULE("S", lc + "\x00" + rest)
  | $NUM:lc "\x00" Stmt:last
    => last + "\n"
  | => ""

Stmt ::=
    "println" ";"
    => "lea rdi, [rip + fmt_nl]\nxor eax, eax\ncall _printf"
  | "printsp" ";"
    => "lea rdi, [rip + fmt_sp]\nxor eax, eax\ncall _printf"
  | "printn" /[^;]+/:val ";"
    => RULE("Expr", val) + "\nmov esi, eax\nlea rdi, [rip + fmtn]\nxor eax, eax\ncall _printf"
  | "print" /[^;]+/:val ";"
    => RULE("Expr", val) + "\nmov esi, eax\nlea rdi, [rip + fmt]\nxor eax, eax\ncall _printf"
  | "*" PtrChain:ptr "=" /[^;]+/:val ";"
    => let val_asm = RULE("Expr", val);
       ptr + "\npush rax\n" + val_asm + "\npop rcx\nmov DWORD PTR [rcx], eax"
  | $VAR:name "=" /[^;]+/:val ";"
    => let off = RULE("OffOf", name + "\x00" + val);
       RULE("Expr", val) + "\nmov DWORD PTR [rbp-" + off + "], eax"
  | "{" => ""
  | "}" => ""
  | /[\s]+/:ws => ""
  | /./:c => c

OffOf ::= /[^@]+/:name "@" $NUM:off "\x00" /[\s\S]*/:rest => off
        | $IDENT:name "\x00" /[\s\S]*/:rest => name

// ── While loop ───────────────────────────────────────────────────────────

WhileBody ::= /[^{}]+/:text WhileBody:rest => text + rest
            | "{" WhileBody:inner "}" WhileBody:rest => "{" + inner + "}" + rest
            | => ""

GenWhile ::= $NUM:lc "\x00" /[^\x00]+/:cond "\x00" /[\s\S]*/:body
    => ".L" + lc + ":\n"
     + RULE("Expr", cond) + "\ntest eax, eax\nje .L" + (lc + "1") + "\n"
     + RULE("Stmts", (lc + "2") + "\x00" + body) + "\n"
     + "jmp .L" + lc + "\n.L" + (lc + "1") + ":\n"

// ── Expression rules (precedence: Compare > AddExpr > MulExpr > Primary) ──

Expr ::= /[\s\S]+/:s => RULE("Compare", s)

Compare ::= $NO_COMP:l "<=" $NUM:r => RULE("Expr", l) + "\ncmp eax, " + r + "\nsetle al\nmovzx eax, al"
  | $NO_COMP:l "<" $NUM:r   => RULE("Expr", l) + "\ncmp eax, " + r + "\nsetl al\nmovzx eax, al"
  | $NO_COMP:l "<=" $VAR:r  => RULE("Expr", l) + "\nmov ecx, eax\n" + RULE("Expr", r) + "\ncmp ecx, eax\nsetle al\nmovzx eax, al"
  | $NO_COMP:l "<" $VAR:r   => RULE("Expr", l) + "\nmov ecx, eax\n" + RULE("Expr", r) + "\ncmp ecx, eax\nsetl al\nmovzx eax, al"
  | $VAR:l "<=" /[\s\S]+/:r  => RULE("Expr", r) + "\nmov ecx, eax\n" + RULE("Expr", l) + "\ncmp eax, ecx\nsetle al\nmovzx eax, al"
  | $VAR:l "<" /[\s\S]+/:r   => RULE("Expr", r) + "\nmov ecx, eax\n" + RULE("Expr", l) + "\ncmp eax, ecx\nsetl al\nmovzx eax, al"
  | $NO_COMP:l "<=" /[\s\S]+/:r => RULE("Expr", l) + "\npush rax\n" + RULE("Expr", r) + "\npop rcx\ncmp ecx, eax\nsetle al\nmovzx eax, al"
  | $NO_COMP:l "<" /[\s\S]+/:r  => RULE("Expr", l) + "\npush rax\n" + RULE("Expr", r) + "\npop rcx\ncmp ecx, eax\nsetl al\nmovzx eax, al"
  | /[\s\S]+/:s => RULE("AddExpr", s)

AddExpr ::= $NO_ADD:l "+" "0" => RULE("Expr", l)
          | "0" "+" $NO_ADD:r => RULE("Expr", r)
          | $NO_ADD:l "-" "0" => RULE("Expr", l)
          | $NO_ADD:l "+" "1" => RULE("Expr", l) + "\ninc eax"
          | $NO_ADD:l "-" "1" => RULE("Expr", l) + "\ndec eax"
          | $NO_ADD:l "+" $NUM:r => RULE("Expr", l) + "\nlea eax, [eax + " + r + "]"
          | $NO_ADD:l "-" $NUM:r => RULE("Expr", l) + "\nlea eax, [eax - " + r + "]"
          | $NO_ADD:l "+" $VAR:r => RULE("Expr", l) + "\nmov ecx, eax\n" + RULE("Expr", r) + "\nadd eax, ecx"
          | $NO_ADD:l "-" $VAR:r => RULE("Expr", l) + "\nmov ecx, eax\n" + RULE("Expr", r) + "\nsub ecx, eax\nmov eax, ecx"
          | $VAR:l "+" /[\s\S]+/:r => RULE("Expr", r) + "\nmov ecx, eax\n" + RULE("Expr", l) + "\nadd eax, ecx"
          | $VAR:l "-" /[\s\S]+/:r => RULE("Expr", r) + "\nmov ecx, eax\n" + RULE("Expr", l) + "\nsub eax, ecx"
          | $NO_ADD:l "+" /[\s\S]+/:r => RULE("Expr", l) + "\npush rax\n" + RULE("Expr", r) + "\npop rcx\nadd eax, ecx"
  | $NO_ADD:l "-" /[\s\S]+/:r => RULE("Expr", l) + "\npush rax\n" + RULE("Expr", r) + "\nmov ecx, eax\npop rax\nsub eax, ecx"
  | /[\s\S]+/:s => RULE("MulExpr", s)

MulExpr ::= $NO_MUL:l "*" "0" => "xor eax, eax"
          | $NO_MUL:l "*" "1" => RULE("Expr", l)
          | "0" "*" $NO_MUL:r => "xor eax, eax"
          | "1" "*" $NO_MUL:r => RULE("Expr", r)
          | $NO_MUL:l "/" "1" => RULE("Expr", l)
          | "0" "/" $NO_MUL:r => "xor eax, eax"
          | $NO_MUL:l "*" "2" => RULE("Expr", l) + "\nadd eax, eax"
%for val, shift in [("4","2"), ("8","3"), ("16","4"), ("32","5"), ("64","6")] {
          | $NO_MUL:l "*" "{val}" => RULE("Expr", l) + "\nshl eax, {shift}"
}
          | $NO_MUL:l "*" $NUM:r => RULE("Expr", l) + "\nimul eax, eax, " + r
          | $NO_MUL:l "/" $NUM:r => RULE("Expr", l) + "\nmov ecx, " + r + "\ncdq\nidiv ecx"
          | $NO_MUL:l "*" $VAR:r => RULE("Expr", l) + "\nmov ecx, eax\n" + RULE("Expr", r) + "\nimul eax, ecx"
          | $NO_MUL:l "/" $VAR:r => RULE("Expr", l) + "\npush rax\n" + RULE("Expr", r) + "\nmov ecx, eax\npop rax\ncdq\nidiv ecx"
          | $VAR:l "*" /[\s\S]+/:r => RULE("Expr", r) + "\nmov ecx, eax\n" + RULE("Expr", l) + "\nimul eax, ecx"
          | $VAR:l "/" /[\s\S]+/:r => RULE("Expr", r) + "\nmov ecx, eax\n" + RULE("Expr", l) + "\ncdq\nidiv ecx"
          | $NO_MUL:l "/" /[\s\S]+/:r => RULE("Expr", l) + "\npush rax\n" + RULE("Expr", r) + "\nmov ecx, eax\npop rax\ncdq\nidiv ecx"
  | $NO_MUL:l "*" /[\s\S]+/:r => RULE("Expr", l) + "\npush rax\n" + RULE("Expr", r) + "\npop rcx\nimul eax, ecx"
  | /[\s\S]+/:s => RULE("Primary", s)

Primary ::= "(" $PAREN:e ")" => RULE("Expr", e)
          | "&" $VAR:name => RULE("AddrOf", name)
          | "*" PtrChain:inner => inner + "\nmov eax, [rax]"
          | "0" => "xor eax, eax"
          | $NUM:n => "mov eax, " + n
          | $VAR:name => RULE("AnnotatedVar", name)

PtrChain ::= $VAR:name => RULE("LoadQWord", name)
           | "*" PtrChain:inner => inner + "\nmov rax, [rax]"

AnnotatedVar ::= /[^@]+/:name "@" $NUM:off => "mov eax, DWORD PTR [rbp-" + off + "]"
               | $IDENT:name => "mov eax, DWORD PTR [rbp-" + name + "]"

LoadQWord ::= /[^@]+/:name "@" $NUM:off => "mov rax, QWORD PTR [rbp-" + off + "]"
            | $IDENT:name => "mov rax, QWORD PTR [rbp-" + name + "]"

AddrOf ::= /[^@]+/:name "@" $NUM:off => "lea rax, [rbp-" + off + "]"
OffOfPtr ::= /[^@]+/:name "@" $NUM:off => off
