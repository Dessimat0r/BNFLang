// C-like → x86-64 asm (Meta-SBNF)
// Engine: PEG + LET RULE REPLACE.
// Operators: + - * / < <=

$IDENT = /[a-zA-Z_]\w*/
$DECL_HDR = $NUM:n "\x00" /[^\x00]*/:i "\x00int "

Program ::= /[\s\S]*/:src => RULE("Decls", "4\x00\x00" + src)

// ── Declaration phase ─────────────────────────────────────────────────────

Decls ::= $NUM:n "\x00" /[^\x00]*/:i "\x00" /[\s\S]*/:c => RULE("TryDecl", n + "\x00" + i + "\x00" + c)

TryDecl ::= $DECL_HDR /\*+/ $IDENT:v "=" "&" $VAR:ref ";" "\n" /[\s\S]*/:c
    => DECL(v, n, i, c, "lea rax, [rbp-" + RULE("OffOf", ref) + "]" \+ "mov QWORD PTR [rbp-" + n + "], rax" \+ "")
  | $DECL_HDR /\*+/ $IDENT:v ";" "\n" /[\s\S]*/:c => DECL(v, n, i, c, "")
  | $DECL_HDR $IDENT:v "=" $NUM:val ";" "\n" /[\s\S]*/:c => DECL(v, n, i, c, "mov DWORD PTR [rbp-" + n + "], " + val \+ "")
  | $DECL_HDR $IDENT:v "=" /[^;\x00]+/:val ";" "\n" /[\s\S]*/:c => DECL(v, n, i, c, "mov eax, " + val \+ "mov DWORD PTR [rbp-" + n + "], eax" \+ "")
  | $NUM:n "\x00" /[^\x00]*/:i "\x00" /[\s\S]*/:c
    => ".data\nfmt: .asciz \"%d\\n\"\nfmtn: .asciz \"%d \"\nfmt_nl: .asciz \"\\n\"\nfmt_sp: .asciz \" \"\n"
     + ".text\n.globl _main\n.intel_syntax noprefix\n"
     + "_main:\npush rbp\nmov rbp, rsp\nsub rsp, " + n + "\n"
     + i
     + RULE("Stmts", "0\x00" + c)
     + "mov rsp, rbp\npop rbp\nret\n"

// ── Statement phase ──────────────────────────────────────────────────────

Stmts ::= $NUM:lc "\x00" /[\s\S]*/:code => RULE("S", lc + "\x00" + code)

S ::= $NUM:lc "\x00" "while" "(" $PAREN:cond ")" "{" WhileBody:body "}" /[\s\S]*/:rest
    => RULE("GenWhile", lc + "\x00" + cond + "\x00" + body) + "\n" + RULE("S", (lc + "2") + "\x00" + rest)
  | $NUM:lc "\x00" "while" "(" $PAREN:cond ")" "{" WhileBody:body "}" => RULE("GenWhile", lc + "\x00" + cond + "\x00" + body)
  | $NUM:lc "\x00" Stmt:first "\n" /[\s\S]*/:rest => first + "\n" + RULE("S", lc + "\x00" + rest)
  | $NUM:lc "\x00" Stmt:last => last + "\n"
  | => ""

Stmt ::=
%for kw, fmt in [("println", "fmt_nl"), ("printsp", "fmt_sp")] {
    "{kw}" ";" => "lea rdi, [rip + {fmt}]" \+ "xor eax, eax" \+ "call _printf" |
}
%for kw, fmt in [("printn", "fmtn"), ("print", "fmt")] {
    "{kw}" /[^;]+/:val ";" => RULE("Expr", val) \+ "mov esi, eax" \+ "lea rdi, [rip + {fmt}]" \+ "xor eax, eax" \+ "call _printf" |
}
    "sprintf" $VAR:buf /[^;]+/:val ";"
    => let val_asm = RULE("Expr", val); let buf_off = RULE("OffOf", buf + "\x00" + val);
       "lea rdi, [rbp-" + buf_off + "]" \+ "lea rsi, [rip + fmt]" \+ val_asm \+ "mov edx, eax" \+ "xor eax, eax" \+ "call _sprintf"
  | "*" PtrChain:ptr "=" /[^;]+/:val ";"
    => let val_asm = RULE("Expr", val); ptr \+ "push rax" \+ val_asm \+ "pop rcx" \+ "mov DWORD PTR [rcx], eax"
  | $VAR:name "=" /[^;]+/:val ";" => let off = RULE("OffOf", name + "\x00" + val); RULE("Expr", val) \+ "mov DWORD PTR [rbp-" + off + "], eax"
  | "{" => "" | "}" => "" | /[\s]+/:ws => "" | /./:c => c

OffOf ::= $VAR_OFF => off | $IDENT:name => name

// ── While loop ───────────────────────────────────────────────────────────

WhileBody ::= /[^{}]+/:text WhileBody:rest => text + rest | "{" WhileBody:inner "}" WhileBody:rest => "{" + inner + "}" + rest | => ""

GenWhile ::= $NUM:lc "\x00" /[^\x00]+/:cond "\x00" /[\s\S]*/:body
    => ".L" + lc + ":\n" + RULE("Expr", cond) \+ "test eax, eax" \+ "je .L" + (lc + "1") \+ RULE("Stmts", (lc + "2") + "\x00" + body) \+ "jmp .L" + lc \+ ".L" + (lc + "1") + ":\n"

// ── Expression rules (precedence: Compare > AddExpr > MulExpr > Primary) ──

Expr ::= /[\s\S]+/:s => RULE("Compare", s)

%for op, cond in [("<=", "le"), ("<", "l")] {
Compare ::= $NO_COMP:l "{op}" $NUM:r => RULE("Expr", l) \+ "cmp eax, " + r \+ "set{cond} al" \+ "movzx eax, al"
  | $NO_COMP:l "{op}" $VAR:r  => RULE("Expr", l) \+ "mov ecx, eax" \+ RULE("Expr", r) \+ "cmp ecx, eax" \+ "set{cond} al" \+ "movzx eax, al"
  | $VAR:l "{op}" /[\s\S]+/:r  => RULE("Expr", r) \+ "mov ecx, eax" \+ RULE("Expr", l) \+ "cmp eax, ecx" \+ "set{cond} al" \+ "movzx eax, al"
  | $NO_COMP:l "{op}" /[\s\S]+/:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "pop rcx" \+ "cmp ecx, eax" \+ "set{cond} al" \+ "movzx eax, al"
}
  | /[\s\S]+/:s => RULE("AddExpr", s)

AddExpr ::= $NO_ADD:l /[+-]/ "0" => RULE("Expr", l)
          | "0" "+" $NO_ADD:r => RULE("Expr", r)
%for op, inst in [("+", "inc"), ("-", "dec")] {
          | $NO_ADD:l "{op}" "1" => RULE("Expr", l) \+ "{inst} eax"
}
%for op in ["+", "-"] {
          | $NO_ADD:l "{op}" $NUM:r => RULE("Expr", l) \+ "lea eax, [eax {op} " + r + "]"
}
          | $NO_ADD:l "+" $VAR:r => RULE("Expr", l) \+ "mov ecx, eax" \+ RULE("Expr", r) \+ "add eax, ecx"
          | $NO_ADD:l "-" $VAR:r => RULE("Expr", l) \+ "mov ecx, eax" \+ RULE("Expr", r) \+ "sub ecx, eax" \+ "mov eax, ecx"
          | $VAR:l "+" /[\s\S]+/:r => RULE("Expr", r) \+ "mov ecx, eax" \+ RULE("Expr", l) \+ "add eax, ecx"
          | $VAR:l "-" /[\s\S]+/:r => RULE("Expr", r) \+ "mov ecx, eax" \+ RULE("Expr", l) \+ "sub eax, ecx"
          | $NO_ADD:l "+" /[\s\S]+/:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "pop rcx" \+ "add eax, ecx"
  | $NO_ADD:l "-" /[\s\S]+/:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "mov ecx, eax" \+ "pop rax" \+ "sub eax, ecx"
  | /[\s\S]+/:s => RULE("MulExpr", s)

MulExpr ::= $NO_MUL:l "*" "0" => "xor eax, eax"
          | "0" /[*/]/ $NO_MUL:r => "xor eax, eax"
          | $NO_MUL:l /[*/]/ "1" => RULE("Expr", l)
          | "1" "*" $NO_MUL:r => RULE("Expr", r)
          | $NO_MUL:l "*" "2" => RULE("Expr", l) \+ "add eax, eax"
%for val, shift in [("4","2"), ("8","3"), ("16","4"), ("32","5"), ("64","6")] {
          | $NO_MUL:l "*" "{val}" => RULE("Expr", l) \+ "shl eax, {shift}"
}
          | $NO_MUL:l "*" $NUM:r => RULE("Expr", l) \+ "imul eax, eax, " + r
          | $NO_MUL:l "/" $NUM:r => RULE("Expr", l) \+ "mov ecx, " + r \+ "cdq" \+ "idiv ecx"
          | $NO_MUL:l "*" $VAR:r => RULE("Expr", l) \+ "mov ecx, eax" \+ RULE("Expr", r) \+ "imul eax, ecx"
          | $NO_MUL:l "/" $VAR:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "mov ecx, eax" \+ "pop rax" \+ "cdq" \+ "idiv ecx"
          | $VAR:l "*" /[\s\S]+/:r => RULE("Expr", r) \+ "mov ecx, eax" \+ RULE("Expr", l) \+ "imul eax, ecx"
          | $VAR:l "/" /[\s\S]+/:r => RULE("Expr", r) \+ "mov ecx, eax" \+ RULE("Expr", l) \+ "cdq" \+ "idiv ecx"
          | $NO_MUL:l "/" /[\s\S]+/:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "mov ecx, eax" \+ "pop rax" \+ "cdq" \+ "idiv ecx"
  | $NO_MUL:l "*" /[\s\S]+/:r => RULE("Expr", l) \+ "push rax" \+ RULE("Expr", r) \+ "pop rcx" \+ "imul eax, ecx"
  | /[\s\S]+/:s => RULE("Primary", s)

Primary ::= "(" $PAREN:e ")" => RULE("Expr", e)
          | "&" $VAR:name => RULE("AddrOf", name)
          | "*" PtrChain:inner => inner \+ "mov eax, [rax]"
          | "0" => "xor eax, eax"
          | $NUM:n => "mov eax, " + n
          | $VAR:name => RULE("AnnotatedVar", name)

PtrChain ::= $VAR:name => RULE("LoadQWord", name) | "*" PtrChain:inner => inner \+ "mov rax, [rax]"

AnnotatedVar ::= $VAR_OFF => "mov eax, DWORD PTR [rbp-" + off + "]" | $IDENT:name => "mov eax, DWORD PTR [rbp-" + name + "]"
LoadQWord    ::= $VAR_OFF => "mov rax, QWORD PTR [rbp-" + off + "]" | $IDENT:name => "mov rax, QWORD PTR [rbp-" + name + "]"
AddrOf       ::= $VAR_OFF => "lea rax, [rbp-" + off + "]"
