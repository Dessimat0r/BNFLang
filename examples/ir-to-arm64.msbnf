// Micro-IR → ARM64 assembly (Apple Silicon, macOS) (Meta-SBNF)
Program ::= /[\s\S]*/:src
    => ".data\nfmt: .asciz \"%d\\n\"\nfmtn: .asciz \"%d \"\nfmt_nl: .asciz \"\\n\"\nfmt_sp: .asciz \" \"\nfmt_2d: .asciz \"%d %d\\n\"\nfmt_3d: .asciz \"%d %d %d\\n\"\n.text\n"
     + RULE("Lines", src)

%include "ir_common.msbnf"

@def STORE_STACK(val_asm, off):
    val_asm \+ "str w0, [x29, #-" + off + "]"

Line ::= "GLOBAL" $IDENT:gname $NUM:val
    => ".data\n.globl _" + gname + "\n.p2align 2\n_" + gname + ": .word " + val + "\n.text"
  | "FUNC" $IDENT:fname => ".globl " + fname + "\n" + fname + ":"
  | "FRAME" $NUM:sz => "stp x29, x30, [sp, #-16]!\nmov x29, sp\nsub sp, sp, #" + sz
  | "END_FUNC" => "mov sp, x29\nldp x29, x30, [sp], #16\nret"
  | "INIT_PTR" $VAR:v "@" $NUM:off " = &" $VAR:ref "@" $NUM:ref_off => "sub x16, x29, #" + ref_off + "\nstr x16, [x29, #-" + off + "]"
  | "INIT_PTR" $VAR:v "@" $NUM:off " = 0" => "str xzr, [x29, #-" + off + "]"
  | "INIT_ZERO" $VAR:v "@" $NUM:off => "str wzr, [x29, #-" + off + "]"
  | "INIT_VAR" $VAR:v "@" $NUM:off " = " /[\s\S]+/:val => STORE_STACK(RULE("Expr", val), off)
  | "STORE" $VAR:v "@" $NUM:off " = " /[\s\S]+/:val => STORE_STACK(RULE("Expr", val), off)
  | "LABEL" $LABEL:lbl => lbl + ":"
  | "JMP_Z" /[^\n,]+/:cond "," $LABEL:lbl => let c_asm = RULE("Expr", cond); c_asm \+ "cbz w0, " + lbl
  | "JMP_NZ" /[^\n,]+/:cond "," $LABEL:lbl => let c_asm = RULE("Expr", cond); c_asm \+ "cbnz w0, " + lbl
  | "JMP" $LABEL:lbl => "b " + lbl
  | "RETURN" /[\s\S]+/:val => let val_asm = RULE("Expr", val); val_asm \+ "mov sp, x29" \+ "ldp x29, x30, [sp], #16" \+ "ret"
%for i, reg in enumerate(["w0", "w1", "w2", "w3"], 1) {
  | "PARAM{i}" $VAR:v "@" $NUM:off => "str {reg}, [x29, #-" + off + "]"
}
  | "STORE_GVAR" $IDENT:gname "=" /[\s\S]+/:val
    => let val_asm = RULE("Expr", val); val_asm \+ "adrp x16, _" + gname + "@PAGE" \+ "add x16, x16, _" + gname + "@PAGEOFF" \+ "str w0, [x16]"
  | "STORE_PTR_VAR" "_aptr" /[^=]+/:name "=" /[\s\S]+/:val
    => let val_asm = RULE("Expr", val); let off = RULE("OffOf", "_aptr" + name); val_asm \+ "str x0, [x29, #-" + off + "]"
  | "STORE_DEREF" /[^\n=]+/:ptr "=" /[\s\S]+/:val
    => let p_asm = RULE("Expr", ptr); let val_asm = RULE("Expr", val); p_asm \+ "str w0, [sp, #-16]!" \+ val_asm \+ "ldr x1, [sp], #16" \+ "str w0, [x1]"
  | "CALL_DEST3" $VAR:v "@" $NUM:off " = " $IDENT:func /[^ ]+/:v1 /[^ ]+/:v2 /[\s\S]+/:v3
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); let a3 = RULE("Expr", v3); a1 \+ "str w0, [sp, #-16]!" \+ a2 \+ "str w0, [sp, #-16]!" \+ a3 \+ "mov w2, w0" \+ "ldr w1, [sp], #16" \+ "ldr w0, [sp], #16" \+ "bl _" + func \+ "str w0, [x29, #-" + off + "]"
  | "CALL_DEST2" $VAR:v "@" $NUM:off " = " $IDENT:func /[^ ]+/:v1 /[\s\S]+/:v2
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); a1 \+ "str w0, [sp, #-16]!" \+ a2 \+ "mov w1, w0" \+ "ldr w0, [sp], #16" \+ "bl _" + func \+ "str w0, [x29, #-" + off + "]"
  | "CALL_DEST1" $VAR:v "@" $NUM:off " = " $IDENT:func /[\s\S]+/:v1
    => let a1 = RULE("Expr", v1); a1 \+ "bl _" + func \+ "str w0, [x29, #-" + off + "]"
  | "CALL_DEST0" $VAR:v "@" $NUM:off " = " $IDENT:func
    => "bl _" + func \+ "str w0, [x29, #-" + off + "]"
  | "CALL3" $IDENT:func /[^ ]+/:v1 /[^ ]+/:v2 /[\s\S]+/:v3
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); let a3 = RULE("Expr", v3); a1 \+ "str w0, [sp, #-16]!" \+ a2 \+ "str w0, [sp, #-16]!" \+ a3 \+ "mov w2, w0" \+ "ldr w1, [sp], #16" \+ "ldr w0, [sp], #16" \+ "bl _" + func
  | "CALL2" $IDENT:func /[^ ]+/:v1 /[\s\S]+/:v2
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); a1 \+ "str w0, [sp, #-16]!" \+ a2 \+ "mov w1, w0" \+ "ldr w0, [sp], #16" \+ "bl _" + func
  | "CALL1" $IDENT:func /[\s\S]+/:v1 => let a1 = RULE("Expr", v1); a1 \+ "bl _" + func
  | "CALL0" $IDENT:func => "call _" + func
  | "PRINT3" $IDENT:fmt /[^ ]+/:v1 /[^ ]+/:v2 /[\s\S]+/:v3
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); let a3 = RULE("Expr", v3); a1 \+ "str x0, [sp]" \+ a2 \+ "str x0, [sp, #8]" \+ a3 \+ "str x0, [sp, #16]" \+ "adrp x0, " + fmt + "@PAGE" \+ "add x0, x0, " + fmt + "@PAGEOFF" \+ "bl _printf"
  | "PRINT2" $IDENT:fmt /[^ ]+/:v1 /[\s\S]+/:v2
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); a1 \+ "str x0, [sp]" \+ a2 \+ "str x0, [sp, #8]" \+ "adrp x0, " + fmt + "@PAGE" \+ "add x0, x0, " + fmt + "@PAGEOFF" \+ "bl _printf"
  | "PRINT1" $IDENT:fmt /[\s\S]+/:val
    => let a1 = RULE("Expr", val); a1 \+ "str x0, [sp]" \+ "adrp x0, " + fmt + "@PAGE" \+ "add x0, x0, " + fmt + "@PAGEOFF" \+ "bl _printf"
  | "PRINT0" $IDENT:fmt => "adrp x0, " + fmt + "@PAGE" \+ "add x0, x0, " + fmt + "@PAGEOFF" \+ "bl _printf"
  | "SPRINTF3" $VAR:v "@" $NUM:off $IDENT:fmt /[^ ]+/:v1 /[^ ]+/:v2 /[\s\S]+/:v3
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); let a3 = RULE("Expr", v3); a1 \+ "str x0, [sp]" \+ a2 \+ "str x0, [sp, #8]" \+ a3 \+ "str x0, [sp, #16]" \+ "sub x0, x29, #" + off \+ "adrp x1, " + fmt + "@PAGE" \+ "add x1, x1, " + fmt + "@PAGEOFF" \+ "bl _sprintf"
  | "SPRINTF2" $VAR:v "@" $NUM:off $IDENT:fmt /[^ ]+/:v1 /[\s\S]+/:v2
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); a1 \+ "str x0, [sp]" \+ a2 \+ "str x0, [sp, #8]" \+ "sub x0, x29, #" + off \+ "adrp x1, " + fmt + "@PAGE" \+ "add x1, x1, " + fmt + "@PAGEOFF" \+ "bl _sprintf"
  | "SPRINTF" $VAR:v "@" $NUM:off $IDENT:fmt /[\s\S]+/:val
    => let val_asm = RULE("Expr", val); val_asm \+ "str x0, [sp]" \+ "sub x0, x29, #" + off \+ "adrp x1, " + fmt + "@PAGE" \+ "add x1, x1, " + fmt + "@PAGEOFF" \+ "bl _sprintf"
  | "none" => ""
  | /[\s]*/ => ""

OffOf ::= $VAR "@" $NUM:off /[\s\S]*/ => off | $IDENT:name /[\s\S]*/ => name

Expr ::= "(" /[^)]+/:inner ")" => RULE("OpExpr", inner)
       | /[\s\S]+/:s => RULE("PrimExpr", s)

OpExpr ::=
%for op, inst in [("AND", "and"), ("ORR", "orr"), ("EOR", "eor"), ("LSL", "lsl"), ("ASR", "asr")] {
    /[^ ]+/:l "{op}" /[\s\S]+/:r => RULE("Expr", l) \+ "str w0, [sp, #-16]!" \+ RULE("Expr", r) \+ "ldr w1, [sp], #16" \+ "{inst} w0, w1, w0" |
}
%for op, cond in [("EQ", "eq"), ("NE", "ne"), ("LE", "le"), ("LT", "lt"), ("GE", "ge"), ("GT", "gt")] {
    /[^ ]+/:l "{op}" /[\s\S]+/:r => RULE("Expr", l) \+ "str w0, [sp, #-16]!" \+ RULE("Expr", r) \+ "ldr w1, [sp], #16" \+ "cmp w1, w0" \+ "cset w0, {cond}" |
}
    /[^ ]+/:l "ADD" /[\s\S]+/:r => RULE("Expr", l) \+ "str x0, [sp, #-16]!" \+ RULE("Expr", r) \+ "ldr x1, [sp], #16" \+ "sxtw x0, w0" \+ "add x0, x1, x0"
  | /[^ ]+/:l "SUB" /[\s\S]+/:r => RULE("Expr", l) \+ "str w0, [sp, #-16]!" \+ RULE("Expr", r) \+ "ldr w1, [sp], #16" \+ "sub w0, w1, w0"
  | /[^ ]+/:l "MUL" /[\s\S]+/:r => RULE("Expr", l) \+ "str w0, [sp, #-16]!" \+ RULE("Expr", r) \+ "ldr w1, [sp], #16" \+ "mul w0, w1, w0"
  | /[^ ]+/:l "DIV" /[\s\S]+/:r => RULE("Expr", l) \+ "str w0, [sp, #-16]!" \+ RULE("Expr", r) \+ "ldr w1, [sp], #16" \+ "sdiv w0, w1, w0"
  | /[^ ]+/:l "MOD" /[\s\S]+/:r => RULE("Expr", l) \+ "str w0, [sp, #-16]!" \+ RULE("Expr", r) \+ "ldr w1, [sp], #16" \+ "sdiv w8, w1, w0" \+ "msub w0, w8, w0, w1"
  | "NOT" /[\s\S]+/:r => RULE("Expr", r) \+ "mvn w0, w0"

PrimExpr ::=
    "0" /[\s]*/ => "mov w0, 0"
  | $NUM:n => "mov w0, " + n
  | "G_" $IDENT:gname => "adrp x16, _G_" + gname + "@PAGE\nadd x16, x16, _G_" + gname + "@PAGEOFF\nldr w0, [x16]"
  | "ADDR" $VAR:v "@" $NUM:off => "sub x0, x29, #" + off
  | "DEREF" $VAR:v "@" $NUM:off => "ldr x0, [x29, #-" + off + "]\nldr w0, [x0]"
  | "DEREF" "DEREF" $VAR:v "@" $NUM:off => "ldr x0, [x29, #-" + off + "]\nldr x0, [x0]\nldr w0, [x0]"
  | "CALL_VAL3" $IDENT:func /[^ ]+/:v1 /[^ ]+/:v2 /[\s\S]+/:v3
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); let a3 = RULE("Expr", v3); a1 \+ "str w0, [sp, #-16]!" \+ a2 \+ "str w0, [sp, #-16]!" \+ a3 \+ "mov w2, w0" \+ "ldr w1, [sp], #16" \+ "ldr w0, [sp], #16" \+ "bl _" + func
  | "CALL_VAL2" $IDENT:func /[^ ]+/:v1 /[\s\S]+/:v2
    => let a1 = RULE("Expr", v1); let a2 = RULE("Expr", v2); a1 \+ "str w0, [sp, #-16]!" \+ a2 \+ "mov w1, w0" \+ "ldr w0, [sp], #16" \+ "bl _" + func
  | "CALL_VAL1" $IDENT:func /[\s\S]+/:v1 => let a1 = RULE("Expr", v1); a1 \+ "bl _" + func
  | "CALL_VAL0" $IDENT:func => "bl _" + func
  | $VAR:v "@" $NUM:off => "ldr w0, [x29, #-" + off + "]"
