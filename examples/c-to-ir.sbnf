// C-like → Micro-IR Generator (Meta-SBNF)
// Precedence: Bitwise > Compare > AddExpr > MulExpr > Primary

/[0-9]+/:n "\x00" /[^\x00]*/:i "\x00" /(?:long\s+long|char|short|int|long|void)\s*/ = /[0-9]+/:n "\x00" /[^\x00]*/:i "\x00" /(?:long\s+long|char|short|int|long|void)\s*/

Program ::= /[\s\S]*/:src => RULE("FuncList", src)

FuncList ::= /[^\x00]+/:f "\x00" /[\s\S]*/:rest => RULE("OneFunc", f) + "\n" + RULE("FuncList", rest)
          | /[\s\S]+/:f => RULE("OneFunc", f)

OneFunc ::= "GLOBAL " /[a-zA-Z_]\w*/:gname /[0-9]+/:val
    => "GLOBAL " + gname + " " + val + "\n"
  | "FUNC " /[a-zA-Z_]\w*/:fname "\n" /[\s\S]*/:body
    => "FUNC " + fname + "\n" + RULE("Decls", "4\x00\x00" + body)
  | /[\s\S]*/:body
    => "FUNC _main\n" + RULE("Decls", "4\x00\x00" + body)

// ── Declaration phase ─────────────────────────────────────────────────────

Decls ::= /[0-9]+/:n "\x00" /[^\x00]*/:i "\x00" /[\s\S]*/:c => RULE("TryDecl", n + "\x00" + i + "\x00" + c)

TryDecl ::= /[0-9]+/:n "\x00" /[^\x00]*/:i "\x00" /(?:long\s+long|char|short|int|long|void)\s*/ /\*+/ /[a-zA-Z_]\w*/:v "=" "&" /[a-zA-Z_@0-9]+/:ref ";" "\n" /[\s\S]*/:c
    => LET(new_n, n + "8", LET(anno, v + "@" + n, LET(new_i, i + "INIT_PTR " + v + "@" + n + " = &" + ref + "\n", RULE("Decls", new_n + "\x00" + new_i + "\x00" + REPLACE(v, anno, c)))))
  | /[0-9]+/:n "\x00" /[^\x00]*/:i "\x00" /(?:long\s+long|char|short|int|long|void)\s*/ /\*+/ /[a-zA-Z_]\w*/:v "=" /[0-9]+/:val ";" "\n" /[\s\S]*/:c
    => LET(new_n, n + "8", LET(anno, v + "@" + n, LET(new_i, i + "INIT_PTR " + v + "@" + n + " = 0\n", RULE("Decls", new_n + "\x00" + new_i + "\x00" + REPLACE(v, anno, c)))))
  | /[0-9]+/:n "\x00" /[^\x00]*/:i "\x00" /(?:long\s+long|char|short|int|long|void)\s*/ /\*+/ /[a-zA-Z_]\w*/:v ";" "\n" /[\s\S]*/:c => LET(new_n, n + "8", LET(anno, v + "@" + n, LET(new_i, i + "", RULE("Decls", new_n + "\x00" + new_i + "\x00" + REPLACE(v, anno, c)))))
  | /[0-9]+/:n "\x00" /[^\x00]*/:i "\x00" /(?:long\s+long|char|short|int|long|void)\s*/ /[a-zA-Z_]\w*/:v "=" "0" ";" "\n" /[\s\S]*/:c
    => LET(code, RULE("DeclZeroCode", v + "\x00" + n), LET(new_n, n + "8", LET(anno, v + "@" + n, LET(new_i, i + code, RULE("Decls", new_n + "\x00" + new_i + "\x00" + REPLACE(v, anno, c))))))
  | /[0-9]+/:n "\x00" /[^\x00]*/:i "\x00" /(?:long\s+long|char|short|int|long|void)\s*/ /[a-zA-Z_]\w*/:v "=" /[^;\x00]+/:val ";" "\n" /[\s\S]*/:c
    => LET(val_ir, RULE("Expr", val), LET(new_n, n + "8", LET(anno, v + "@" + n, LET(new_i, i + "INIT_VAR " + v + "@" + n + " = " + val_ir + "\n", RULE("Decls", new_n + "\x00" + new_i + "\x00" + REPLACE(v, anno, c))))))
  | /[0-9]+/:n "\x00" /[^\x00]*/:i "\x00" /[\s\S]*/:c
    => "FRAME " + RULE("Ceil16", n + "32") + "\n"
     + i
     + RULE("Stmts", "10\x00none\x00none\x00" + c)
     + "END_FUNC\n"

DeclZeroCode ::= "buf_pad" /[\s\S]*/ => ""
               | /[a-zA-Z_]\w*/:v "\x00" /[0-9]+/:n => "INIT_ZERO " + v + "@" + n + "\n"

// ── Statement phase ──────────────────────────────────────────────────────

Stmts ::= /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" /[\s\S]*/:code => RULE("S", lc + "\x00" + cl + "\x00" + bl + "\x00" + code)

S ::= /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "while" "(" /(?:[^()]+|\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\))*/:cond ")" "{" BlockBody:body "}" /[\s\S]*/:rest
    => RULE("GenWhile", lc + "\x00" + cond + "\x00" + body) + "\n" + RULE("S", (lc + "5") + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "while" "(" /(?:[^()]+|\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\))*/:cond ")" "{" BlockBody:body "}"
    => RULE("GenWhile", lc + "\x00" + cond + "\x00" + body)
  | /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "do_while" "(" /(?:[^()]+|\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\))*/:cond ")" "{" BlockBody:body "}" /[\s\S]*/:rest
    => RULE("GenDoWhile", lc + "\x00" + cond + "\x00" + body) + "\n" + RULE("S", (lc + "5") + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "do_while" "(" /(?:[^()]+|\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\))*/:cond ")" "{" BlockBody:body "}"
    => RULE("GenDoWhile", lc + "\x00" + cond + "\x00" + body)
  | /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "if" "(" /(?:[^()]+|\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\))*/:cond ")" "{" BlockBody:b1 "}" "else" "{" BlockBody:b2 "}" /[\s\S]*/:rest
    => RULE("GenIfElse", lc + "\x00" + cl + "\x00" + bl + "\x00" + cond + "\x00" + b1 + "\x00" + b2) + "\n" + RULE("S", (lc + "5") + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "if" "(" /(?:[^()]+|\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\))*/:cond ")" "{" BlockBody:b1 "}" "else" "{" BlockBody:b2 "}"
    => RULE("GenIfElse", lc + "\x00" + cl + "\x00" + bl + "\x00" + cond + "\x00" + b1 + "\x00" + b2)
  | /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "if" "(" /(?:[^()]+|\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\))*/:cond ")" "{" BlockBody:body "}" /[\s\S]*/:rest
    => RULE("GenIf", lc + "\x00" + cl + "\x00" + bl + "\x00" + cond + "\x00" + body) + "\n" + RULE("S", (lc + "5") + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "if" "(" /(?:[^()]+|\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\))*/:cond ")" "{" BlockBody:body "}"
    => RULE("GenIf", lc + "\x00" + cl + "\x00" + bl + "\x00" + body)
  | /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" Stmt:first "\n" /[\s\S]*/:rest
    => RULE("GenStmt", cl + "\x00" + bl + "\x00" + first) + "\n" + RULE("S", lc + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" Stmt:last => RULE("GenStmt", cl + "\x00" + bl + "\x00" + last) + "\n"
  | => ""

GenStmt ::= /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "break;" => "JMP .L" + bl
          | /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "continue;" => "JMP .L" + cl
          | /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" /[\s\S]*/:s => s

Stmt ::=
    "return" /[^;]+/:val ";" => "RETURN " + RULE("Expr", val)
  | "G_" /[a-zA-Z_]\w*/:gname "=" /[^;]+/:val ";"
    => LET(val_ir, RULE("Expr", val), "STORE_GVAR G_" + gname + " = " + val_ir)
  | Var:v "=" "_param1;" => "PARAM1 " + v
  | Var:v "=" "_param2;" => "PARAM2 " + v
  | Var:v "=" "_param3;" => "PARAM3 " + v
  | Var:v "=" "_param4;" => "PARAM4 " + v
  | Var:dest "=" "call3" /[a-zA-Z_]\w*/:func Var:v1 Var:v2 Var:v3 ";"
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), LET(a3, RULE("Expr", v3), "CALL_DEST3 " + dest + " = " + func + " " + a1 + " " + a2 + " " + a3)))
  | Var:dest "=" "call2" /[a-zA-Z_]\w*/:func Var:v1 Var:v2 ";"
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), "CALL_DEST2 " + dest + " = " + func + " " + a1 + " " + a2))
  | Var:dest "=" "call1" /[a-zA-Z_]\w*/:func /[^;\x00]+/:v1 ";"
    => LET(a1, RULE("Expr", v1), "CALL_DEST1 " + dest + " = " + func + " " + a1)
  | Var:dest "=" "call0" /[a-zA-Z_]\w*/:func ";"
    => "CALL_DEST0 " + dest + " = " + func
  | "call3" /[a-zA-Z_]\w*/:func Var:v1 Var:v2 Var:v3 ";"
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), LET(a3, RULE("Expr", v3), "CALL3 " + func + " " + a1 + " " + a2 + " " + a3)))
  | "call2" /[a-zA-Z_]\w*/:func Var:v1 Var:v2 ";"
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), "CALL2 " + func + " " + a1 + " " + a2))
  | "call1" /[a-zA-Z_]\w*/:func /[^)\x00\s]+/:v1
    => LET(a1, RULE("Expr", v1), "CALL1 " + func + " " + a1)
  | "call0" /[a-zA-Z_]\w*/:func ";" => "CALL0 " + func
  | "print3" Var:v1 Var:v2 Var:v3 ";"
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), LET(a3, RULE("Expr", v3), "PRINT3 fmt_3d " + a1 + " " + a2 + " " + a3)))
  | "print2" Var:v1 Var:v2 ";"
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), "PRINT2 fmt_2d " + a1 + " " + a2))
  | "sprintf3" Var:buf Var:v1 Var:v2 Var:v3 ";"
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), LET(a3, RULE("Expr", v3), "SPRINTF3 " + buf + " fmt_3d " + a1 + " " + a2 + " " + a3)))
  | "sprintf2" Var:buf Var:v1 Var:v2 ";"
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), "SPRINTF2 " + buf + " fmt_2d " + a1 + " " + a2))
  | "sprintf" Var:buf Var:val ";"
    => LET(val_ir, RULE("Expr", val), "SPRINTF " + buf + " fmt " + val_ir)
  | "println" ";" => "PRINT0 fmt_nl"
  | "printsp" ";" => "PRINT0 fmt_sp"
  | "printn" /[^;]+/:val ";" => LET(val_ir, RULE("Expr", val), "PRINT1 fmtn " + val_ir)
  | "print" /[^;]+/:val ";" => LET(val_ir, RULE("Expr", val), "PRINT1 fmt " + val_ir)
  | "_aptr" /[^=]+/:name "=" /[^;]+/:val ";"
    => LET(val_ir, RULE("Expr", val), "STORE_PTR_VAR _aptr" + name + " = " + val_ir)
  | "*" PtrChain:ptr "=" /[^;]+/:val ";"
    => LET(val_ir, RULE("Expr", val), "STORE_DEREF " + ptr + " = " + val_ir)
  | Var:name "=" /[^;]+/:val ";" => "STORE " + name + " = " + RULE("Expr", val)
  | "{" => "" | "}" => "" | /[\s]+/:ws => "" | /./:c => c

OffOf ::= /[^@]+/:name "@" /[0-9]+/:off /[\s\S]*/ => off | /[a-zA-Z_]\w*/:name /[\s\S]*/ => name

// ── Loops and conditionals ───────────────────────────────────────────────

BlockBody ::= /[^{}]+/:text BlockBody:rest => text + rest | "{" BlockBody:inner "}" BlockBody:rest => "{" + inner + "}" + rest | => ""

GenWhile ::= /[0-9]+/:lc "\x00" /[^\x00]+/:cond "\x00" /[\s\S]*/:body
    => "LABEL .L" + lc + "\n" + "JMP_Z " + RULE("Expr", cond) + ", .L" + (lc + "1") + "\n" + RULE("Stmts", (lc + "2") + "\x00" + lc + "\x00" + (lc + "1") + "\x00" + body) + "JMP .L" + lc + "\nLABEL .L" + (lc + "1")

GenDoWhile ::= /[0-9]+/:lc "\x00" /[^\x00]+/:cond "\x00" /[\s\S]*/:body
    => "LABEL .L" + lc + "\n" + RULE("Stmts", (lc + "2") + "\x00" + (lc + "3") + "\x00" + (lc + "1") + "\x00" + body) + "LABEL .L" + (lc + "3") + "\nJMP_NZ " + RULE("Expr", cond) + ", .L" + lc + "\nLABEL .L" + (lc + "1")

GenIf ::= /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" /[^\x00]+/:cond "\x00" /[\s\S]*/:body
    => "JMP_Z " + RULE("Expr", cond) + ", .L" + lc + "\n" + RULE("Stmts", (lc + "1") + "\x00" + cl + "\x00" + bl + "\x00" + body) + "LABEL .L" + lc

GenIfElse ::= /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" /[^\x00]+/:cond "\x00" /[^\x00]*/:b1 "\x00" /[\s\S]*/:b2
    => "JMP_Z " + RULE("Expr", cond) + ", .L" + lc + "\n" + RULE("Stmts", (lc + "2") + "\x00" + cl + "\x00" + bl + "\x00" + b1) + "JMP .L" + (lc + "1") + "\nLABEL .L" + lc + "\n" + RULE("Stmts", (lc + "3") + "\x00" + cl + "\x00" + bl + "\x00" + b2) + "LABEL .L" + (lc + "1")

// ── Expression rules ─────────────────────────────────────────────────────

Num ::= /[0-9]+/:n /[\s]*/ => n
Var ::= /[a-zA-Z_@0-9]+/:v /[\s]*/ => v

Expr ::= /[\s\S]+/:s => RULE("BitwiseExpr", s)

BitwiseExpr ::= "~" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|&[a-zA-Z_]\w*|[^\+\-\|\&\^\<\>\(\);])+/:r => "(NOT " + RULE("Expr", r) + ")"
              | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|&[a-zA-Z_]\w*|[^\+\-\|\&\^\<\>\(\);])+/:l "&" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|&[a-zA-Z_]\w*|[^\+\-\|\&\^\<\>\(\);])+/:r => "(" + RULE("Expr", l) + " AND " + RULE("Expr", r) + ")"
              | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|&[a-zA-Z_]\w*|[^\+\-\|\&\^\<\>\(\);])+/:l "|" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|&[a-zA-Z_]\w*|[^\+\-\|\&\^\<\>\(\);])+/:r => "(" + RULE("Expr", l) + " ORR " + RULE("Expr", r) + ")"
              | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|&[a-zA-Z_]\w*|[^\+\-\|\&\^\<\>\(\);])+/:l "^" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|&[a-zA-Z_]\w*|[^\+\-\|\&\^\<\>\(\);])+/:r => "(" + RULE("Expr", l) + " EOR " + RULE("Expr", r) + ")"
              | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|&[a-zA-Z_]\w*|[^\+\-\|\&\^\<\>\(\);])+/:l "<<" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|&[a-zA-Z_]\w*|[^\+\-\|\&\^\<\>\(\);])+/:r => "(" + RULE("Expr", l) + " LSL " + RULE("Expr", r) + ")"
              | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|&[a-zA-Z_]\w*|[^\+\-\|\&\^\<\>\(\);])+/:l ">>" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|&[a-zA-Z_]\w*|[^\+\-\|\&\^\<\>\(\);])+/:r => "(" + RULE("Expr", l) + " ASR " + RULE("Expr", r) + ")"
              | /[\s\S]+/:s => RULE("Compare", s)

Compare ::=
    /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!\(\);])+/:l "==" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!\(\);])+/:r => "(" + RULE("Expr", l) + " EQ " + RULE("Expr", r) + ")" |
    /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!\(\);])+/:l "!=" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!\(\);])+/:r => "(" + RULE("Expr", l) + " NE " + RULE("Expr", r) + ")" |
    /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!\(\);])+/:l "<=" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!\(\);])+/:r => "(" + RULE("Expr", l) + " LE " + RULE("Expr", r) + ")" |
    /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!\(\);])+/:l "<" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!\(\);])+/:r => "(" + RULE("Expr", l) + " LT " + RULE("Expr", r) + ")" |
    /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!\(\);])+/:l ">=" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!\(\);])+/:r => "(" + RULE("Expr", l) + " GE " + RULE("Expr", r) + ")" |
    /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!\(\);])+/:l ">" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!\(\);])+/:r => "(" + RULE("Expr", l) + " GT " + RULE("Expr", r) + ")" |
    /[\s\S]+/:s => RULE("AddExpr", s)

AddExpr ::= /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|&[a-zA-Z_]\w*|[^\+\-\|\&\^\<\>\(\);])+/:l /[+-]/ "0" => RULE("Expr", l)
          | "0" "+" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|&[a-zA-Z_]\w*|[^\+\-\|\&\^\<\>\(\);])+/:r => RULE("Expr", r)
          | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|&[a-zA-Z_]\w*|[^\+\-\|\&\^\<\>\(\);])+/:l "+" /[\s\S]+/:r => "(" + RULE("Expr", l) + " ADD " + RULE("Expr", r) + ")"
          | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|&[a-zA-Z_]\w*|[^\+\-\|\&\^\<\>\(\);])+/:l "-" /[\s\S]+/:r => "(" + RULE("Expr", l) + " SUB " + RULE("Expr", r) + ")"
          | /[\s\S]+/:s => RULE("MulExpr", s)

MulExpr ::= /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^\+\-\*/%\(\);])+/:l "*" "0" => "0"
          | "0" /[*/]/ /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^\+\-\*/%\(\);])+/:r => "0"
          | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^\+\-\*/%\(\);])+/:l /[*/]/ "1" => RULE("Expr", l)
          | "1" "*" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^\+\-\*/%\(\);])+/:r => RULE("Expr", r)
          | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^\+\-\*/%\(\);])+/:l "%" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|&[a-zA-Z_]\w*|[^\+\-\|\&\^\<\>\(\);])+/:r => "(" + RULE("Expr", l) + " MOD " + RULE("Expr", r) + ")"
          | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^\+\-\*/%\(\);])+/:l "*" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|&[a-zA-Z_]\w*|[^\+\-\|\&\^\<\>\(\);])+/:r => "(" + RULE("Expr", l) + " MUL " + RULE("Expr", r) + ")"
          | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^\+\-\*/%\(\);])+/:l "/" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|&[a-zA-Z_]\w*|[^\+\-\|\&\^\<\>\(\);])+/:r => "(" + RULE("Expr", l) + " DIV " + RULE("Expr", r) + ")"
          | /[\s\S]+/:s => RULE("Primary", s)

Primary ::= "(" /(?:[^()]+|\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\))*/:e ")" /[\s]*/ => RULE("Expr", e)
          | "&" Var:name => "ADDR " + name
          | "*" PtrChain:inner => "DEREF " + inner
          | "call3" /[a-zA-Z_]\w*/:func Var:v1 Var:v2 Var:v3
            => "CALL_VAL3 " + func + " " + RULE("Expr", v1) + " " + RULE("Expr", v2) + " " + RULE("Expr", v3)
          | "call2" /[a-zA-Z_]\w*/:func Var:v1 Var:v2
            => "CALL_VAL2 " + func + " " + RULE("Expr", v1) + " " + RULE("Expr", v2)
          | "call1" /[a-zA-Z_]\w*/:func /[^)\x00\s]+/:v1
            => "CALL_VAL1 " + func + " " + RULE("Expr", v1)
          | "call0" /[a-zA-Z_]\w*/:func => "CALL_VAL0 " + func
          | "0" /[\s]*/ => "0"
          | Num:n => n
          | "G_" /[a-zA-Z_]\w*/:gname /[\s]*/ => "G_" + gname
          | Var:name => name

PtrChain ::= Var:name => name | "*" PtrChain:inner => "DEREF " + inner

