// C-like → x86-64 asm (Meta-SBNF)
// Engine: PEG + LET RULE REPLACE.
// Precedence: Bitwise > Compare > AddExpr > MulExpr > Primary


Program ::= /[\s\S]*/:src
    => ".data\nfmt: .asciz \"%d\\n\"\nfmtn: .asciz \"%d \"\nfmt_nl: .asciz \"\\n\"\nfmt_sp: .asciz \" \"\nfmt_2d: .asciz \"%d %d\\n\"\nfmt_3d: .asciz \"%d %d %d\\n\"\n.text\n.intel_syntax noprefix\n"
     + RULE("FuncList", src)

FuncList ::= /[^\x00]+/:f "\x00" /[\s\S]*/:rest => RULE("OneFunc", f) + "\n" + RULE("FuncList", rest)
          | /[\s\S]+/:f => RULE("OneFunc", f)

OneFunc ::= "FUNC " /[a-zA-Z_]\w*/:fname "\n" /[\s\S]*/:body
    => ".globl " + fname + "\n" + fname + ":\n" + RULE("Decls", "4\x00\x00" + body)
  | /[\s\S]*/:body
    => ".globl _main\n_main:\n" + RULE("Decls", "4\x00\x00" + body)

// ── Declaration phase ─────────────────────────────────────────────────────

Decls ::= /[0-9]+/:n "\x00" /[^\x00]*/:i "\x00" /[\s\S]*/:c => RULE("TryDecl", n + "\x00" + i + "\x00" + c)

TryDecl ::= /[0-9]+/:n "\x00" /[^\x00]*/:i "\x00" /(?:long\s+long|char|short|int|long|void)\s*/ /\*+/ /[a-zA-Z_]\w*/:v "=" "&" /[a-zA-Z_@0-9]+/:ref ";" "\n" /[\s\S]*/:c
    => LET(new_n, n + "8", LET(anno, v + "@" + n, LET(new_i, i + "lea rax, [rbp-" + RULE("OffOf", ref) + "]" + "\n" + "mov QWORD PTR [rbp-" + n + "], rax" + "\n" + "", RULE("Decls", new_n + "\x00" + new_i + "\x00" + REPLACE(v, anno, c)))))
  | /[0-9]+/:n "\x00" /[^\x00]*/:i "\x00" /(?:long\s+long|char|short|int|long|void)\s*/ /\*+/ /[a-zA-Z_]\w*/:v ";" "\n" /[\s\S]*/:c => LET(new_n, n + "8", LET(anno, v + "@" + n, LET(new_i, i + "", RULE("Decls", new_n + "\x00" + new_i + "\x00" + REPLACE(v, anno, c)))))
  | /[0-9]+/:n "\x00" /[^\x00]*/:i "\x00" /(?:long\s+long|char|short|int|long|void)\s*/ /[a-zA-Z_]\w*/:v "=" /[0-9]+/:val ";" "\n" /[\s\S]*/:c => LET(new_n, n + "8", LET(anno, v + "@" + n, LET(new_i, i + "mov DWORD PTR [rbp-" + n + "], " + val + "\n" + "", RULE("Decls", new_n + "\x00" + new_i + "\x00" + REPLACE(v, anno, c)))))
  | /[0-9]+/:n "\x00" /[^\x00]*/:i "\x00" /(?:long\s+long|char|short|int|long|void)\s*/ /[a-zA-Z_]\w*/:v "=" /[^;\x00]+/:val ";" "\n" /[\s\S]*/:c
    => LET(val_asm, RULE("Expr", val), LET(new_n, n + "8", LET(anno, v + "@" + n, LET(new_i, i + val_asm + "\n" + "mov DWORD PTR [rbp-" + n + "], eax" + "\n" + "", RULE("Decls", new_n + "\x00" + new_i + "\x00" + REPLACE(v, anno, c))))))
  | /[0-9]+/:n "\x00" /[^\x00]*/:i "\x00" /[\s\S]*/:c
    => "push rbp\nmov rbp, rsp\nsub rsp, " + n + "\n"
     + i
     + RULE("Stmts", "10\x00none\x00none\x00" + c)
     + "mov rsp, rbp\npop rbp\nret\n"

// ── Statement phase ──────────────────────────────────────────────────────

Stmts ::= /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" /[\s\S]*/:code => RULE("S", lc + "\x00" + cl + "\x00" + bl + "\x00" + code)

S ::= /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "while" "(" /(?:[^()]+|\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\))*/:cond ")" "{" BlockBody:body "}" /[\s\S]*/:rest
    => RULE("GenWhile", lc + "\x00" + cond + "\x00" + body) + "\n" + RULE("S", (lc + "5") + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "while" "(" /(?:[^()]+|\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\))*/:cond ")" "{" BlockBody:body "}"
    => RULE("GenWhile", lc + "\x00" + cond + "\x00" + body)
  | /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "do_while" "(" /(?:[^()]+|\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\))*/:cond ")" "{" BlockBody:body "}" /[\s\S]*/:rest
    => RULE("GenDoWhile", lc + "\x00" + cond + "\x00" + body) + "\n" + RULE("S", (lc + "5") + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "do_while" "(" /(?:[^()]+|\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\))*/:cond ")" "{" BlockBody:body "}"
    => RULE("GenDoWhile", lc + "\x00" + cond + "\x00" + body)
  | /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "if" "(" /(?:[^()]+|\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\))*/:cond ")" "{" BlockBody:b1 "}" "else" "{" BlockBody:b2 "}" /[\s\S]*/:rest
    => RULE("GenIfElse", lc + "\x00" + cl + "\x00" + bl + "\x00" + cond + "\x00" + b1 + "\x00" + b2) + "\n" + RULE("S", (lc + "5") + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "if" "(" /(?:[^()]+|\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\))*/:cond ")" "{" BlockBody:b1 "}" "else" "{" BlockBody:b2 "}"
    => RULE("GenIfElse", lc + "\x00" + cl + "\x00" + bl + "\x00" + cond + "\x00" + b1 + "\x00" + b2)
  | /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "if" "(" /(?:[^()]+|\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\))*/:cond ")" "{" BlockBody:body "}" /[\s\S]*/:rest
    => RULE("GenIf", lc + "\x00" + cl + "\x00" + bl + "\x00" + cond + "\x00" + body) + "\n" + RULE("S", (lc + "5") + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "if" "(" /(?:[^()]+|\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\))*/:cond ")" "{" BlockBody:body "}"
    => RULE("GenIf", lc + "\x00" + cl + "\x00" + bl + "\x00" + cond + "\x00" + body)
  | /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" Stmt:first "\n" /[\s\S]*/:rest
    => RULE("GenStmt", cl + "\x00" + bl + "\x00" + first) + "\n" + RULE("S", lc + "\x00" + cl + "\x00" + bl + "\x00" + rest)
  | /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" Stmt:last => RULE("GenStmt", cl + "\x00" + bl + "\x00" + last) + "\n"
  | => ""

GenStmt ::= /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "break;" => "jmp .L" + bl
          | /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" "continue;" => "jmp .L" + cl
          | /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" /[\s\S]*/:s => s

Stmt ::=
    "break;" => "break;"
  | "continue;" => "continue;"
  | "return" /[^;]+/:val ";" => RULE("Expr", val) + "\n" + "mov rsp, rbp" + "\n" + "pop rbp" + "\n" + "ret"
  | Var:v "=" "_param1;" => LET(off, RULE("OffOf", v + "\x00_param1"), "mov DWORD PTR [rbp-" + off + "], edi")
  | Var:v "=" "_param2;" => LET(off, RULE("OffOf", v + "\x00_param2"), "mov DWORD PTR [rbp-" + off + "], esi")
  | Var:v "=" "_param3;" => LET(off, RULE("OffOf", v + "\x00_param3"), "mov DWORD PTR [rbp-" + off + "], edx")
  | Var:v "=" "_param4;" => LET(off, RULE("OffOf", v + "\x00_param4"), "mov DWORD PTR [rbp-" + off + "], ecx")
  | Var:dest "=" "call3" /[a-zA-Z_]\w*/:func Var:v1 Var:v2 Var:v3 ";"
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), LET(a3, RULE("Expr", v3), LET(off, RULE("OffOf", dest + "\x00" + func), a1 + "\n" + "push rax" + "\n" + a2 + "\n" + "push rax" + "\n" + a3 + "\n" + "mov edx, eax" + "\n" + "pop rax" + "\n" + "mov esi, eax" + "\n" + "pop rax" + "\n" + "mov edi, eax" + "\n" + "call _" + func + "\n" + "mov DWORD PTR [rbp-" + off + "], eax"))))
  | Var:dest "=" "call2" /[a-zA-Z_]\w*/:func Var:v1 Var:v2 ";"
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), LET(off, RULE("OffOf", dest + "\x00" + func), a1 + "\n" + "push rax" + "\n" + a2 + "\n" + "mov esi, eax" + "\n" + "pop rax" + "\n" + "mov edi, eax" + "\n" + "call _" + func + "\n" + "mov DWORD PTR [rbp-" + off + "], eax")))
  | Var:dest "=" "call1" /[a-zA-Z_]\w*/:func /[^;\x00]+/:v1 ";"
    => LET(a1, RULE("Expr", v1), LET(off, RULE("OffOf", dest + "\x00" + func), a1 + "\n" + "mov edi, eax" + "\n" + "call _" + func + "\n" + "mov DWORD PTR [rbp-" + off + "], eax"))
  | Var:dest "=" "call0" /[a-zA-Z_]\w*/:func ";"
    => LET(off, RULE("OffOf", dest + "\x00" + func), "call _" + func + "\n" + "mov DWORD PTR [rbp-" + off + "], eax")
  | "call3" /[a-zA-Z_]\w*/:func Var:v1 Var:v2 Var:v3 ";"
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), LET(a3, RULE("Expr", v3), a1 + "\n" + "push rax" + "\n" + a2 + "\n" + "push rax" + "\n" + a3 + "\n" + "mov edx, eax" + "\n" + "pop rax" + "\n" + "mov esi, eax" + "\n" + "pop rax" + "\n" + "mov edi, eax" + "\n" + "call _" + func)))
  | "call2" /[a-zA-Z_]\w*/:func Var:v1 Var:v2 ";"
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), a1 + "\n" + "push rax" + "\n" + a2 + "\n" + "mov esi, eax" + "\n" + "pop rax" + "\n" + "mov edi, eax" + "\n" + "call _" + func))
  | "call1" /[a-zA-Z_]\w*/:func /[^;\x00]+/:v1 ";"
    => LET(a1, RULE("Expr", v1), a1 + "\n" + "mov edi, eax" + "\n" + "call _" + func)
  | "call0" /[a-zA-Z_]\w*/:func ";" => "call _" + func
  | "print3" Var:v1 Var:v2 Var:v3 ";"
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), LET(a3, RULE("Expr", v3), a1 + "\n" + "mov esi, eax" + "\n" + a2 + "\n" + "mov edx, eax" + "\n" + a3 + "\n" + "mov ecx, eax" + "\n" + "lea rdi, [rip + fmt_3d]" + "\n" + "xor eax, eax" + "\n" + "call _printf")))
  | "print2" Var:v1 Var:v2 ";"
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), a1 + "\n" + "mov esi, eax" + "\n" + a2 + "\n" + "mov edx, eax" + "\n" + "lea rdi, [rip + fmt_2d]" + "\n" + "xor eax, eax" + "\n" + "call _printf"))
  | "sprintf3" Var:buf Var:v1 Var:v2 Var:v3 ";"
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), LET(a3, RULE("Expr", v3), LET(buf_off, RULE("OffOf", buf + "\x00" + v1), "lea rdi, [rbp-" + buf_off + "]" + "\n" + "lea rsi, [rip + fmt_3d]" + "\n" + a1 + "\n" + "mov edx, eax" + "\n" + a2 + "\n" + "mov ecx, eax" + "\n" + a3 + "\n" + "mov r8d, eax" + "\n" + "xor eax, eax" + "\n" + "call _sprintf"))))
  | "sprintf2" Var:buf Var:v1 Var:v2 ";"
    => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), LET(buf_off, RULE("OffOf", buf + "\x00" + v1), "lea rdi, [rbp-" + buf_off + "]" + "\n" + "lea rsi, [rip + fmt_2d]" + "\n" + a1 + "\n" + "mov edx, eax" + "\n" + a2 + "\n" + "mov ecx, eax" + "\n" + "xor eax, eax" + "\n" + "call _sprintf")))
  | "sprintf" Var:buf Var:val ";"
    => LET(val_asm, RULE("Expr", val), LET(buf_off, RULE("OffOf", buf + "\x00" + val), "lea rdi, [rbp-" + buf_off + "]" + "\n" + "lea rsi, [rip + fmt]" + "\n" + val_asm + "\n" + "mov edx, eax" + "\n" + "xor eax, eax" + "\n" + "call _sprintf"))

  | "println" ";" => "lea rdi, [rip + fmt_nl]" + "\n" + "xor eax, eax" + "\n" + "call _printf"

  | "printsp" ";" => "lea rdi, [rip + fmt_sp]" + "\n" + "xor eax, eax" + "\n" + "call _printf"

  | "printn" /[^;]+/:val ";" => RULE("Expr", val) + "\n" + "mov esi, eax" + "\n" + "lea rdi, [rip + fmtn]" + "\n" + "xor eax, eax" + "\n" + "call _printf"

  | "print" /[^;]+/:val ";" => RULE("Expr", val) + "\n" + "mov esi, eax" + "\n" + "lea rdi, [rip + fmt]" + "\n" + "xor eax, eax" + "\n" + "call _printf"
  | "*" PtrChain:ptr "=" /[^;]+/:val ";"
    => LET(val_asm, RULE("Expr", val), ptr + "\n" + "push rax" + "\n" + val_asm + "\n" + "pop rcx" + "\n" + "mov DWORD PTR [rcx], eax")
  | Var:name "=" /[^;]+/:val ";" => LET(off, RULE("OffOf", name + "\x00" + val), RULE("Expr", val) + "\n" + "mov DWORD PTR [rbp-" + off + "], eax")
  | "{" => "" | "}" => "" | /[\s]+/:ws => "" | /./:c => c

OffOf ::= /[^@]+/:name "@" /[0-9]+/:off /[\s\S]*/ => off | /[a-zA-Z_]\w*/:name /[\s\S]*/ => name

// ── Loops and conditionals ───────────────────────────────────────────────

BlockBody ::= /[^{}]+/:text BlockBody:rest => text + rest | "{" BlockBody:inner "}" BlockBody:rest => "{" + inner + "}" + rest | => ""

GenWhile ::= /[0-9]+/:lc "\x00" /[^\x00]+/:cond "\x00" /[\s\S]*/:body
    => ".L" + lc + ":\n" + RULE("Expr", cond) + "\n" + "test eax, eax" + "\n" + "je .L" + (lc + "1") + "\n" + RULE("Stmts", (lc + "2") + "\x00" + lc + "\x00" + (lc + "1") + "\x00" + body) + "\n" + "jmp .L" + lc + "\n" + ".L" + (lc + "1") + ":\n"

GenDoWhile ::= /[0-9]+/:lc "\x00" /[^\x00]+/:cond "\x00" /[\s\S]*/:body
    => ".L" + lc + ":\n" + RULE("Stmts", (lc + "2") + "\x00" + (lc + "3") + "\x00" + (lc + "1") + "\x00" + body) + "\n" + ".L" + (lc + "3") + ":\n" + RULE("Expr", cond) + "\n" + "test eax, eax" + "\n" + "jne .L" + lc + "\n" + ".L" + (lc + "1") + ":\n"

GenIf ::= /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" /[^\x00]+/:cond "\x00" /[\s\S]*/:body
    => RULE("Expr", cond) + "\n" + "test eax, eax" + "\n" + "je .L" + lc + "\n" + RULE("Stmts", (lc + "1") + "\x00" + cl + "\x00" + bl + "\x00" + body) + "\n" + ".L" + lc + ":\n"

GenIfElse ::= /[0-9]+/:lc "\x00" /[^\x00]*/:cl "\x00" /[^\x00]*/:bl "\x00" /[^\x00]+/:cond "\x00" /[^\x00]*/:b1 "\x00" /[\s\S]*/:b2
    => RULE("Expr", cond) + "\n" + "test eax, eax" + "\n" + "je .L" + lc + "\n" + RULE("Stmts", (lc + "2") + "\x00" + cl + "\x00" + bl + "\x00" + b1) + "\n" + "jmp .L" + (lc + "1") + "\n" + ".L" + lc + ":\n" + RULE("Stmts", (lc + "3") + "\x00" + cl + "\x00" + bl + "\x00" + b2) + "\n" + ".L" + (lc + "1") + ":\n"

// ── Expression rules (BitwiseExpr > Compare > AddExpr > MulExpr > Primary) ──

Num ::= /[0-9]+/:n /[\s]*/ => n
Var ::= /[a-zA-Z_@0-9]+/:v /[\s]*/ => v

Expr ::= /[\s\S]+/:s => RULE("BitwiseExpr", s)

BitwiseExpr ::= "~" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^+(\-&|^~<>()])+/:r => RULE("Expr", r) + "\n" + "not eax"

              | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^+(\-&|^~<>()])+/:l "&" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^+(\-&|^~<>()])+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "pop rcx" + "\n" + "and eax, ecx"

              | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^+(\-&|^~<>()])+/:l "|" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^+(\-&|^~<>()])+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "pop rcx" + "\n" + "or eax, ecx"

              | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^+(\-&|^~<>()])+/:l "^" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^+(\-&|^~<>()])+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "pop rcx" + "\n" + "xor eax, ecx"

              | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^+(\-&|^~<>()])+/:l "<<" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^+(\-&|^~<>()])+/:r => RULE("Expr", r) + "\n" + "mov ecx, eax" + "\n" + RULE("Expr", l) + "\n" + "shl eax, cl"

              | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^+(\-&|^~<>()])+/:l ">>" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^+(\-&|^~<>()])+/:r => RULE("Expr", r) + "\n" + "mov ecx, eax" + "\n" + RULE("Expr", l) + "\n" + "sar eax, cl"
              | /[\s\S]+/:s => RULE("Compare", s)

Compare ::=

    /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!()])+/:l "==" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!()])+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "pop rcx" + "\n" + "cmp ecx, eax" + "\n" + "sete al" + "\n" + "movzx eax, al"
  |

    /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!()])+/:l "!=" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!()])+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "pop rcx" + "\n" + "cmp ecx, eax" + "\n" + "setne al" + "\n" + "movzx eax, al"
  |

    /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!()])+/:l "<=" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!()])+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "pop rcx" + "\n" + "cmp ecx, eax" + "\n" + "setle al" + "\n" + "movzx eax, al"
  |

    /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!()])+/:l "<" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!()])+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "pop rcx" + "\n" + "cmp ecx, eax" + "\n" + "setl al" + "\n" + "movzx eax, al"
  |

    /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!()])+/:l ">=" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!()])+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "pop rcx" + "\n" + "cmp ecx, eax" + "\n" + "setge al" + "\n" + "movzx eax, al"
  |

    /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!()])+/:l ">" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^<>=!()])+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "pop rcx" + "\n" + "cmp ecx, eax" + "\n" + "setg al" + "\n" + "movzx eax, al"
  |
    /[\s\S]+/:s => RULE("AddExpr", s)

AddExpr ::= /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^+(\-&|^~<>()])+/:l /[+-]/ "0" => RULE("Expr", l)
          | "0" "+" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^+(\-&|^~<>()])+/:r => RULE("Expr", r)
          | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^+(\-&|^~<>()])+/:l "+" /[\s\S]+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "pop rcx" + "\n" + "add eax, ecx"
          | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^+(\-&|^~<>()])+/:l "-" /[\s\S]+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "mov ecx, eax" + "\n" + "pop rax" + "\n" + "sub eax, ecx"
          | /[\s\S]+/:s => RULE("MulExpr", s)

MulExpr ::= /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^*/%()])+/:l "*" "0" => "xor eax, eax"
          | "0" /[*/]/ /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^*/%()])+/:r => "xor eax, eax"
          | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^*/%()])+/:l /[*/]/ "1" => RULE("Expr", l)
          | "1" "*" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^*/%()])+/:r => RULE("Expr", r)
          | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^*/%()])+/:l "%" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^+(\-&|^~<>()])+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "mov ecx, eax" + "\n" + "pop rax" + "\n" + "cdq" + "\n" + "idiv ecx" + "\n" + "mov eax, edx"
          | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^*/%()])+/:l "*" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^+(\-&|^~<>()])+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "pop rcx" + "\n" + "imul eax, ecx"
          | /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^*/%()])+/:l "/" /(?:\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\)|[^+(\-&|^~<>()])+/:r => RULE("Expr", l) + "\n" + "push rax" + "\n" + RULE("Expr", r) + "\n" + "mov ecx, eax" + "\n" + "pop rax" + "\n" + "cdq" + "\n" + "idiv ecx"
          | /[\s\S]+/:s => RULE("Primary", s)

Primary ::= "(" /(?:[^()]+|\((?:[^()]+|\((?:[^()]+|\([^()]*\))*\))*\))*/:e ")" /[\s]*/ => RULE("Expr", e)
          | "&" Var:name => RULE("AddrOf", name)
          | "*" PtrChain:inner => inner + "\n" + "mov eax, [rax]"
          | "call3" /[a-zA-Z_]\w*/:func Var:v1 Var:v2 Var:v3
            => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), LET(a3, RULE("Expr", v3), a1 + "\n" + "push rax" + "\n" + a2 + "\n" + "push rax" + "\n" + a3 + "\n" + "mov edx, eax" + "\n" + "pop rax" + "\n" + "mov esi, eax" + "\n" + "pop rax" + "\n" + "mov edi, eax" + "\n" + "call _" + func)))
          | "call2" /[a-zA-Z_]\w*/:func Var:v1 Var:v2
            => LET(a1, RULE("Expr", v1), LET(a2, RULE("Expr", v2), a1 + "\n" + "push rax" + "\n" + a2 + "\n" + "mov esi, eax" + "\n" + "pop rax" + "\n" + "mov edi, eax" + "\n" + "call _" + func))
          | "call1" /[a-zA-Z_]\w*/:func /[^)\x00\s]+/:v1
            => LET(a1, RULE("Expr", v1), a1 + "\n" + "mov edi, eax" + "\n" + "call _" + func)
          | "call0" /[a-zA-Z_]\w*/:func => "call _" + func
          | "0" /[\s]*/ => "xor eax, eax"
          | Num:n => "mov eax, " + n
          | Var:name => RULE("AnnotatedVar", name)

PtrChain ::= Var:name => RULE("LoadQWord", name) | "*" PtrChain:inner => inner + "\n" + "mov rax, [rax]"

AnnotatedVar ::= /[^@]+/:name "@" /[0-9]+/:off /[\s\S]*/ => "mov eax, DWORD PTR [rbp-" + off + "]" | /[a-zA-Z_]\w*/:name /[\s\S]*/ => "mov eax, DWORD PTR [rbp-" + name + "]"
LoadQWord    ::= /[^@]+/:name "@" /[0-9]+/:off /[\s\S]*/ => "mov rax, QWORD PTR [rbp-" + off + "]" | /[a-zA-Z_]\w*/:name /[\s\S]*/ => "mov rax, QWORD PTR [rbp-" + name + "]"
AddrOf       ::= /[^@]+/:name "@" /[0-9]+/:off /[\s\S]*/ => "lea rax, [rbp-" + off + "]"
